{
    "godotTools.editorPath.godot4": "/usr/local/bin/godot",
    "godot_tools.editor_path": "/usr/local/bin/godot",
    "peacock.color": "#ff3d00",
    "files.exclude": {
        ".godot": true,
        "*.uid": true,
        "**/*.uid": true,
        "*.import": true,
        "**/*.import": true
    },
    "search.exclude": {
        ".godot": true,
        "*.uid": true,
        "**/*.uid": true,
        "*.import": true,
        "**/*.import": true
    },
    // 🤓☝️ 新增：让语言服务器跨越容器，去连接你的 Mac！
    "godotTools.lsp.serverHost": "host.docker.internal",
    "godotTools.lsp.serverPort": 6005
}