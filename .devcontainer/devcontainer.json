{
    "name": "Godot AI Sandbox",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "godot_tools.editor_path": "/usr/local/bin/godot",
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
            },
            "extensions": [
                "geequlim.godot-tools",    // Godot 语言支持
                "ms-python.python",        // Python 支持
                "rooveterinaryinc.roo-cline", // 把这只赛博野兽直接关进笼子里
                "rooveterinaryinc.roo-code-nightly",
                "eamodio.gitlens"
            ]
        }
    },
 
    // 🤓☝️ 核心外科手术：强制绝对路径对齐
    "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
    "workspaceFolder": "${localWorkspaceFolder}",
    
    "remoteUser": "root",

    "mounts": [
        "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind,readonly",
        "source=${localWorkspaceFolder}/readonly_test_target.md,target=${containerWorkspaceFolder}/readonly_test_target.md,type=bind,readonly",
        // 2. 既然你是 root，卷挂载的目标路径也要改回神界专属路径
        "source=vscode-server-data,target=/root/.vscode-server,type=volume"
    ],
    "postCreateCommand": "uv venv .venv && uv pip install -r requirements.txt"
}