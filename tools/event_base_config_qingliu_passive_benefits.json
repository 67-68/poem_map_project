  "option_features": [
    {
      "id": "opt_kuangke",
      "prompt": "用30字以内写一个简短的动作描述——玩家以【狂客】状态回应清流朋友的援助。\n\n狂客行为守则：\n1. 坦然接受，视金钱如粪土——「此衣暖身，此酒暖心，多谢！」\n2. 不卑不亢，把援助转化为知音之间的默契——大笑、举杯、挥毫、长歌。\n3. 绝不卑微道谢，绝不推辞客套——推辞和客套说明你在乎世俗的施舍-接受关系，那不是狂客。\n4. 如果对方刻意含蓄（如王维的「买错了」），狂客也会以同样的含蓄回应——心照不宣即可。",
      "text": "（大笑接过，视若知己）",
      "result": "prop_sub(name=FATIGUE; val=-20)|emo_add(name=TRANQUILITY; val=10)|prop_add(name=INSPIRATION; val=15)",
      "fixed": false,
      "accept_influence": ["qingliu_benefit_type"],
      "pair_role": "branch_A",
      "plugins": {
        "emotion_pair_imagery": {
          "branch_role": "branch_A"
        }
      },
      "requirement": "trait_has(name=kuangda_kuangke)"
    },
    {
      "id": "opt_fengying",
      "prompt": "用30字以内写一个简短的动作描述——玩家以中旷达状态回应清流朋友的援助。动作特征是：窘迫、尴尬、沉默地接受。不是为了讨好，而是因为实在太需要了。",
      "text": "（红着脸收下，默默低下头）",
      "result": "prop_add(name=FATIGUE; val=10)|emo_add(name=SORROW; val=10)",
      "fixed": false,
      "accept_influence": ["qingliu_benefit_type"],
      "pair_role": "fallback",
      "plugins": {
        "emotion_pair_imagery": {
          "branch_role": "fallback"
        }
      },
      "requirement": ""
    },
    {
      "id": "opt_zuanying",
      "prompt": "用30字以内写一个简短的动作描述——玩家以低旷达状态回应清流朋友的援助。动作特征是：表面感激，内心算计。把朋友的善意当作可以利用的资源。\n\n钻营行为守则：\n1. 嘴上说着感激的话，心里在计算这个关系的利用价值。\n2. 可能把王维送的冬衣转手当了换钱，可能利用李白的名声抬高自己的身价，可能把郑虔的救命之恩当作理所当然。\n3. 【绝对禁止】直接出卖朋友、背叛恩人。钻营是算计和利用，不是背刺。",
      "text": "（表面感激，内心盘算）",
      "result": "emo_add(name=AMBITION; val=15)|prop_add(name=BURNOUT; val=15)|emo_add(name=SORROW; val=5)",
      "fixed": false,
      "accept_influence": ["qingliu_benefit_type"],
      "pair_role": "branch_B",
      "plugins": {
        "emotion_pair_imagery": {
          "branch_role": "branch_B"
        }
      },
      "requirement": "trait_has(name=kuangda_zuanying)"
    }
  ],
  "sandbox_feature": {
    "id": "sandbox_qingliu_aid",
    "text": "请生成该维度组合下可能的开头场景描述。只需描述事件如何开场——玩家在什么时间、什么地点、因何缘由遇到了这位清流朋友，对方以何种方式提供了帮助。聚焦于援助发生的瞬间切片，不需要考虑事件的后续发展或选项分支。每个关键词应呈现一个具体的、有画面感的开场瞬间。"
  },
