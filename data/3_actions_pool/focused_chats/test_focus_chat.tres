[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("1_line")
name = "神秘路人"
description = "喂，那边的书生！你就是传说中的杜甫吗？听说你诗写得不错啊。"
chat_position = 0
texture = ExtResource("3_tex_npc")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("1_line")
name = "杜甫"
description = "正是在下。不知阁下有何指教？"
chat_position = 1
texture = ExtResource("2_tex_dufu")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("1_line")
name = "神秘路人"
description = "指教不敢当。只是听闻你最近在长安城四处碰壁，特来探望一番。这世道，有才之人未必能出头啊……"
chat_position = 0
texture = ExtResource("3_tex_npc")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_result"]
script = ExtResource("6_cr")
operators = Array[ExtResource("5_op")]([])
metadata/_custom_type_script = "uid://prpfdj2ag46k"

[sub_resource type="Resource" id="Resource_opt1"]
script = ExtResource("7_eo")
choice_result = SubResource("Resource_result")
description = "（点点头）多谢关心。"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("4_fc")
chats = Array[ExtResource("1_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3")])
options = Array[ExtResource("2_opt")]([SubResource("Resource_opt1")])
uuid = "test_focus_chat"
name = "测试FocusChat"
description = "这是一个用于手动测试 Focus Chat 系统的基础事件。"
metadata/_custom_type_script = "uid://bgapuvasp48wh"
