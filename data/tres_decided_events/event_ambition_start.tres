[resource]
script = ExtResource("2_fc71i")
options = Array[ExtResource("1_qstco")]([SubResource("Resource_y3v7k")])
uuid = "event_ambition_start"
name = "中年寻志"
description = "长安的物价贵得令人咋舌。你在城南偏僻的客舍里租下了一张散发着霉味的床榻，点燃了身上最后半截劣质的残烛。案几上，是你准备投递给当朝右相李林甫的诗文。夜风透窗，烛火摇晃得让人心慌。窗外的萤火虫闪烁，好像暗示着你，和你的才华的命运"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
