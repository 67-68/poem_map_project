[sub_resource type="Resource" id="Resource_diwd6"]
script = ExtResource("1_vofcq")
description = "(内心：九品虽卑，但这可是右相亲自提拔！只要我能理清这长安的钱粮，肃清纲纪，这正是实现我致君尧舜之道的绝佳起点！)“固所愿也！杜某定当鞠躬尽瘁，不负右相大人恩典！”"
choice_result = SubResource("Resource_twd1q")
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[sub_resource type="Resource" id="Resource_vgn00"]
script = ExtResource("1_vofcq")
description = "(内心：这钱粮核算的差事看似位卑权重，实则错综复杂。我一介布衣毫无根基，只怕这账本里藏着轻易就能让人粉身碎骨的深渊。)“某才疏学浅，恐理不清这太府寺的千头万绪，若误了国家大事，万死难辞其咎……”"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("5_gl8u7")
options = Array[ExtResource("1_vofcq")]([SubResource("Resource_diwd6"), SubResource("Resource_vgn00")])
uuid = "update_to_rank9_official_event"
name = "相府青云"
description = "堂内沉香袅袅，那位右相府的绿袍书令史笑得如同春风拂柳，亲热地拉着你的手臂：“子美兄啊，右相大人读了您的《雕赋》，那是赞不绝口！这不，特意在京兆府给您留了个‘太府寺主簿’的肥缺。品阶虽只是从九品下，但那可是掌管京畿粮秣账目的关键枢纽！您想，天子脚下，掌握天下仓廪，何等威风，大有可为啊！”"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
