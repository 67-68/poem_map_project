[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" uid="uid://dnxww6ol71i7d" path="res://core/model/emotion_configs.gd" id="1_emoconf"]
[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="2_baseopt"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="3_baseop"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="4_cr"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="5_eo"]
[ext_resource type="Script" uid="uid://qhuu117ngmbk" path="res://model/random_event.gd" id="6_re"]
[ext_resource type="Script" path="res://core/operators/lianju_score_operator.gd" id="7_lso"]
[ext_resource type="Script" uid="uid://cxfcnsval1p54" path="res://core/operators/push_event_operator.gd" id="8_pusheo"]

[sub_resource type="Resource" id="Resource_lso"]
script = ExtResource("7_lso")
l3_base_score = 30
l2_base_score = 20
l1_base_score = 10
emotion_match_percent = 150

[sub_resource type="Resource" id="Resource_cr_duiju"]
script = ExtResource("4_cr")
operators = Array[ExtResource("3_baseop")]([SubResource("Resource_lso")])

[sub_resource type="Resource" id="Resource_opt_duiju"]
script = ExtResource("5_eo")
choice_result = SubResource("Resource_cr_duiju")
description = "对句"

[sub_resource type="Resource" id="Resource_push_giveup"]
script = ExtResource("8_pusheo")
event_key = "lianju_result"

[sub_resource type="Resource" id="Resource_cr_giveup"]
script = ExtResource("4_cr")
operators = Array[ExtResource("3_baseop")]([SubResource("Resource_push_giveup")])

[sub_resource type="Resource" id="Resource_opt_giveup"]
script = ExtResource("5_eo")
choice_result = SubResource("Resource_cr_giveup")
description = "认输"
custom_context_params = {
"lianju_score": 0,
"lianju_picked_name": "认输",
"lianju_emotion_match": false,
"lianju_evaluation": "宴席上泛起一丝尴尬的沉默…"
}

[resource]
script = ExtResource("6_re")
weight = 0.0
options = Array[ExtResource("2_baseopt")]([SubResource("Resource_opt_duiju"), SubResource("Resource_opt_giveup")])
pre_event_interrupter_sequence = null
uuid = "lianju_player_turn"
name = "联句·我对"
description = "宾客以「{@lianju_npc_name}」为题吟完，轮到你一展诗才了！[br]选择你的意象来对句，根据意象等级和情绪契合度计分。"
