[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://core/model/base_operator.gd" id="1_baseop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="2_choiceresult"]
[ext_resource type="Script" path="res://model/event/base_option.gd" id="3_baseoption"]
[ext_resource type="Script" path="res://core/operators/pop_event_operator.gd" id="4_popevent"]
[ext_resource type="Script" path="res://core/operators/emotion_operator.gd" id="5_emotionop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="6_propop"]
[ext_resource type="Script" path="res://core/operators/imaginary_operator.gd" id="7_imagop"]
[ext_resource type="Script" path="res://core/property_requirement.gd" id="8_prop_req"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="9_eventopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="10_randomevent"]

# ─── on_enter: 舞台置景 ───
# EmotionOperator(TRANQUILITY=3, +15) — Pattern A 单点刺穿
[sub_resource type="Resource" id="Resource_onenter_emotion"]
script = ExtResource("5_emotionop")
_emotion = 3
value = 15

[sub_resource type="Resource" id="Resource_onenter_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_onenter_emotion")])

# ─── Option C (兜底): 悄然离去 ───
[sub_resource type="Resource" id="Resource_optc_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_optc_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_optc_pop")])

[sub_resource type="Resource" id="Resource_optc"]
script = ExtResource("9_eventopt")
choice_result = SubResource("Resource_optc_result")
description = "悄然离去"

# ─── Option B: 静心聆听 ───
[sub_resource type="Resource" id="Resource_optb_imag"]
script = ExtResource("7_imagop")
imaginary_name = "emotion:tranquility"
operation = "upgrade_1"

[sub_resource type="Resource" id="Resource_optb_prop"]
script = ExtResource("6_propop")
_property = 1
value = 5

[sub_resource type="Resource" id="Resource_optb_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_optb_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_optb_imag"), SubResource("Resource_optb_prop"), SubResource("Resource_optb_pop")])

[sub_resource type="Resource" id="Resource_optb"]
script = ExtResource("9_eventopt")
choice_result = SubResource("Resource_optb_result")
description = "静心聆听"

# ─── Option A (高价值): 以诗相和 ───
[sub_resource type="Resource" id="Resource_opta_imag"]
script = ExtResource("7_imagop")
imaginary_name = "entertain:elegant"
operation = "upgrade_1"

[sub_resource type="Resource" id="Resource_opta_prop_fame"]
script = ExtResource("6_propop")
_property = 1
value = 15

[sub_resource type="Resource" id="Resource_opta_prop_insp"]
script = ExtResource("6_propop")
_property = 9
value = -10

[sub_resource type="Resource" id="Resource_opta_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_opta_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_opta_imag"), SubResource("Resource_opta_prop_fame"), SubResource("Resource_opta_prop_insp"), SubResource("Resource_opta_pop")])

[sub_resource type="Resource" id="Resource_opta_req"]
script = ExtResource("8_prop_req")
property = "inspiration"
value = 10
operator = 1

[sub_resource type="Resource" id="Resource_opta"]
script = ExtResource("9_eventopt")
choice_result = SubResource("Resource_opta_result")
requirement = SubResource("Resource_opta_req")
description = "以诗相和"

# ─── Event Resource ───
[resource]
script = ExtResource("10_randomevent")
uuid = "elegant_qin_recital"
name = "月下听琴"
description = "月色如水，你受邀至一处清雅的庭院。一位琴师端坐于梧桐树下，指尖轻拨，琴音如山间清泉流淌而出，沁人心脾。"
on_enter_result = SubResource("Resource_onenter_result")
options = Array[ExtResource("3_baseoption")]([SubResource("Resource_opta"), SubResource("Resource_optb"), SubResource("Resource_optc")])
target_tags = Array[String](["action:entertain:elegant:guqin", "action:entertain:elegant:art"])
_action_tags = [15]
