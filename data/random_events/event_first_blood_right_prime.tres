[resource]
script = ExtResource("2_0ywmh")
options = Array[ExtResource("1_b5y6t")]([SubResource("Resource_h5f8r")])
uuid = "event_first_blood_right_prime"
name = "初见相府"
description = "右相府的朱门比你想象的还要高耸。出乎意料，接待你的并非粗鄙的门卫，而是一位衣着考究的相府主簿。他面带春风般的微笑，甚至命人给你端来了一杯温度恰到好处的茶水。主簿修长的手指不经意地将银钱拨入袖中，随手翻开你的行卷瞥了一眼首联。'好字。'他赞许地点点头，'杜公子的才情，在下必定如实禀报相爷。回去静候佳音吧。"
metadata/_custom_type_script = "uid://qhuu117ngmbk"
