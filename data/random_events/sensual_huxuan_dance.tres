[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://core/model/base_operator.gd" id="1_baseop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="2_choiceresult"]
[ext_resource type="Script" path="res://model/event/base_option.gd" id="3_baseoption"]
[ext_resource type="Script" path="res://core/operators/pop_event_operator.gd" id="4_popevent"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="5_propop"]
[ext_resource type="Script" path="res://core/operators/imaginary_operator.gd" id="6_imagop"]
[ext_resource type="Script" path="res://core/property_requirement.gd" id="7_prop_req"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="8_eventopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="9_randomevent"]

# ─── on_enter: 舞台置景 ───
# PropertyOperator(DRUNK=7, +10) — 入场即微醺
[sub_resource type="Resource" id="Resource_onenter_drunk"]
script = ExtResource("5_propop")
_property = 7
value = 10

# PropertyOperator(MONEY=3, -50) — 入场即破费
[sub_resource type="Resource" id="Resource_onenter_money"]
script = ExtResource("5_propop")
_property = 3
value = -50

[sub_resource type="Resource" id="Resource_onenter_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_onenter_drunk"), SubResource("Resource_onenter_money")])

# ─── Option C (兜底): 拂袖而去 ───
[sub_resource type="Resource" id="Resource_optc_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_optc_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_optc_pop")])

[sub_resource type="Resource" id="Resource_optc"]
script = ExtResource("8_eventopt")
choice_result = SubResource("Resource_optc_result")
description = "拂袖而去"

# ─── Option B: 独饮观舞 ───
[sub_resource type="Resource" id="Resource_optb_drunk"]
script = ExtResource("5_propop")
_property = 7
value = 15

[sub_resource type="Resource" id="Resource_optb_imag"]
script = ExtResource("6_imagop")
imaginary_name = "health:drunk"
operation = "upgrade_1"

[sub_resource type="Resource" id="Resource_optb_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_optb_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_optb_drunk"), SubResource("Resource_optb_imag"), SubResource("Resource_optb_pop")])

[sub_resource type="Resource" id="Resource_optb"]
script = ExtResource("8_eventopt")
choice_result = SubResource("Resource_optb_result")
description = "独饮观舞"

# ─── Option A (高价值): 掷金共舞 ───
[sub_resource type="Resource" id="Resource_opta_money"]
script = ExtResource("5_propop")
_property = 3
value = -200

[sub_resource type="Resource" id="Resource_opta_drunk"]
script = ExtResource("5_propop")
_property = 7
value = 20

[sub_resource type="Resource" id="Resource_opta_imag"]
script = ExtResource("6_imagop")
imaginary_name = "entertain:sensual"
operation = "upgrade_1"

[sub_resource type="Resource" id="Resource_opta_pop"]
script = ExtResource("4_popevent")

[sub_resource type="Resource" id="Resource_opta_result"]
script = ExtResource("2_choiceresult")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_opta_money"), SubResource("Resource_opta_drunk"), SubResource("Resource_opta_imag"), SubResource("Resource_opta_pop")])

[sub_resource type="Resource" id="Resource_opta_req"]
script = ExtResource("7_prop_req")
property = "money"
value = 300
operator = 1

[sub_resource type="Resource" id="Resource_opta"]
script = ExtResource("8_eventopt")
choice_result = SubResource("Resource_opta_result")
requirement = SubResource("Resource_opta_req")
description = "掷金共舞"

# ─── Event Resource ───
[resource]
script = ExtResource("9_randomevent")
uuid = "sensual_huxuan_dance"
name = "胡旋醉舞"
description = "酒肆中，胡姬在急促的鼓点中疯狂旋转，彩袖飞扬如虹。权贵们大声喝彩，空气中弥漫着西域葡萄酒的醇香，一片纸醉金迷。"
on_enter_result = SubResource("Resource_onenter_result")
options = Array[ExtResource("3_baseoption")]([SubResource("Resource_opta"), SubResource("Resource_optb"), SubResource("Resource_optc")])
target_tags = Array[String](["action:entertain:sensual:huxuan", "action:entertain:sensual:wine"])
_action_tags = [9]
