[resource]
script = ExtResource("9_3p8c5")
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_s7vot")]([SubResource("Resource_4v23x")])
uuid = "bai_ye_real_appearance_l2_typec"
name = "诗稿成灰"
description = "你终于站在右相李林甫面前。他接过你的诗稿，指尖捻动纸页，眼神却越过你看向窗外。良久，他将诗稿折成方胜，塞进废纸篓。“诗写得尚可，但本相要的不是这个。”他转向侍从，“带他去书房，替本相写一篇驳斥清流的疏文，明日送来。”你的诗被弃如敝履，你的才气被征用为政治打手。你连愤怒的资格都没有——若敢抗命，明日长安城便多一具无名尸。"
