options = Array[ExtResource("1_nudc8")]([SubResource("Resource_g20pn")])
uuid = "bai_ye_real_appearance_l2_typeb"
name = "诗稿为梯，你为尘"
description = "“尚可。”然后递给身后侍从：“送去八公子房里，明日曲江宴上能用。”侍从躬身退下，你的署名已被抹去。李林甫转向你，笑容未减：“诗写得好，但本相要的不是这个——替本相写一篇驳清流疏，明日送来。”他抬手示意送客，仿佛你已是案头一件用过的工具。"
