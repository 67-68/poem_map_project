[resource]
script = ExtResource("9_j4bat")
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_jkbsp")]([SubResource("Resource_btt1p")])
uuid = "bai_ye_real_appearance_l2_typea"
name = "尚可"
description = "“送到八公子房里。”又转向你，唇边挂着温和的笑：“诗尚可，但本相要的不是这个。”他推开案上一只锦盒，盒底露出一角银锭，“替本相写一篇驳清流疏，明日送来。至于这茶钱——”他顿了顿，目光扫过你身侧，“门子那里，你还没打点完吧。”"
