[resource]
script = ExtResource("9_gnx6m")
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_qhnty")]([SubResource("Resource_m1chx")])
uuid = "bai_ye_real_appearance_l1_typeb"
name = "墨刑改诗"
description = "“犯忌，改‘孤’为‘群’。”旁侧一人凑过来，用指甲弹了弹“直上”两字：“僭越，改‘攀附’。”你的诗被他们传阅，每一处意气都被挑出，笔尖划过纸面如刀剜肉。每改一笔，他们便抬头对你一笑，那笑里没有恶意，只有理所当然的冷漠。末了，诗稿还回来，墨迹与朱批搅作一团，像具被啃净骨头的尸骸。"
