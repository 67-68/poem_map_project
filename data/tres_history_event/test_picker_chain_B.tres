[gd_resource type="Resource" script_class="HistoryEvent" format=3 uid="uid://testpickerb"]

[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="1_opt"]
[ext_resource type="Script" uid="uid://dnxww6ol71i7d" path="res://core/model/emotion_configs.gd" id="1_s47jt"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="2_op"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="3_cr"]
[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="4_bo"]
[ext_resource type="Script" uid="uid://cb7y7amwmeuo4" path="res://core/model/history_event.gd" id="5_he"]
[ext_resource type="Script" uid="uid://w6wvp8tdisfu" path="res://core/operators/trait_choose_operator.gd" id="6_tco"]
[ext_resource type="Script" uid="uid://4seqlwtem2i3" path="res://core/model/poem_taste.gd" id="7_pt"]
[ext_resource type="Script" uid="uid://byn0qqw1xm33f" path="res://core/operators/pop_event_operator.gd" id="8_peo"]
[ext_resource type="Script" uid="uid://cywa1b61mapth" path="res://core/requirements/flag_requirement.gd" id="9_fr"]
[ext_resource type="Script" uid="uid://4inp7s6p2loo" path="res://core/operators/temp_flag_operator.gd" id="10_tfo"]

[sub_resource type="Resource" id="Resource_empty_acc"]
script = ExtResource("3_cr")

[sub_resource type="Resource" id="Resource_empty_not"]
script = ExtResource("3_cr")

[sub_resource type="Resource" id="Resource_empty_rej"]
script = ExtResource("3_cr")

[sub_resource type="Resource" id="Resource_taste"]
script = ExtResource("7_pt")
uuid = "test_picker_taste"
accepted_result = SubResource("Resource_empty_acc")
rejected_result = SubResource("Resource_empty_rej")
not_entered_result = SubResource("Resource_empty_not")

[sub_resource type="Resource" id="Resource_tco"]
script = ExtResource("6_tco")
poem_taste = SubResource("Resource_taste")

[sub_resource type="Resource" id="Resource_tfo"]
script = ExtResource("10_tfo")
flag_id = "temp_picker_triggered"
type = "bool"
value = true

[sub_resource type="Resource" id="Resource_cr_picker"]
script = ExtResource("3_cr")
operators = Array[ExtResource("2_op")]([SubResource("Resource_tco"), SubResource("Resource_tfo")])

[sub_resource type="Resource" id="Resource_req_picker"]
script = ExtResource("9_fr")
flag_id = "temp_picker_triggered"
type = "bool"
value = true
operator = 3
failed_hint = "已触发过 Picker"

[sub_resource type="Resource" id="Resource_opt_picker"]
script = ExtResource("1_opt")
choice_result = SubResource("Resource_cr_picker")
requirement = SubResource("Resource_req_picker")
description = "触发 Picker（测试栈行为）"

[sub_resource type="Resource" id="Resource_peo_return"]
script = ExtResource("8_peo")

[sub_resource type="Resource" id="Resource_cr_return"]
script = ExtResource("3_cr")
operators = Array[ExtResource("2_op")]([SubResource("Resource_peo_return")])

[sub_resource type="Resource" id="Resource_req_return"]
script = ExtResource("9_fr")
flag_id = "temp_picker_triggered"
type = "bool"
value = true
operator = 2
failed_hint = "未触发 Picker"

[sub_resource type="Resource" id="Resource_opt_return"]
script = ExtResource("1_opt")
choice_result = SubResource("Resource_cr_return")
requirement = SubResource("Resource_req_return")
description = "返回"

[resource]
script = ExtResource("5_he")
options = Array[ExtResource("4_bo")]([SubResource("Resource_opt_picker"), SubResource("Resource_opt_return")])
uuid = "test_picker_chain_B"
name = "测试：触发 Picker 事件 B"
description = "这是由事件 A 推入栈的测试事件。「触发 Picker」选择后弹出 Picker 并设置临时 flag（仅首次可用）。之后可选择「返回」退出。"
