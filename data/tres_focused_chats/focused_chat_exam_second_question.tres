[sub_resource type="Resource" id="Resource_fc7bs"]
script = ExtResource("1_t8ywb")
name = "试卷的第二题并非诗词经义，而是策问：“今圣上垂拱而治，右相理政，天下如何？”你握紧了笔，冷汗滴在纸上。主考官（李林甫的心腹）在走道里来回巡视，眼神阴冷。"
background = ExtResource("2_1p5uu")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_8s4po"]
script = ExtResource("3_1amxv")
is_disabled = true
disabled_reason = "考官死死盯着你的笔尖。你敢写下半个字，今天就别想活着走出贡院。"
description = "针砭时弊：言明边镇兵权过重，朝堂言路闭塞。"
metadata/_custom_type_script = "uid://dipsh2f0qa3ei"

[sub_resource type="Resource" id="Resource_qha22"]
