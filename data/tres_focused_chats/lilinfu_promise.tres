[sub_resource type="Resource" id="Resource_60p20"]
script = ExtResource("1_3b1jx")
name = "旁白"
description = "穿过重重院落，相府的奢华让你甚至不敢抬头。你被引至一处熏着沉香的幽静暖阁。珠帘掀开，那位权倾朝野的大唐右相，并没有端坐在高堂之上。"
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_3b1jx"]
script = ExtResource("1_3b1jx")
name = "李林甫"
description = "是子美吗？快，上前些，让老夫好好看看。"
chat_position = 1
texture = ExtResource("2_sndk8")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_1jfdq"]
script = ExtResource("1_3b1jx")
name = "杜甫"
description = "相爷，草民那卷《雕赋》……不知是否污了相爷的眼。"
texture = ExtResource("3_rsi40")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_vjgar"]
script = ExtResource("1_3b1jx")
name = "李林甫"
description = "（叹气）大唐太庞大了，朝堂上尽是些尸位素餐的蠢物。老夫昨夜挑灯将你的赋看了三遍……字字珠玑，这是王佐之才啊！"
chat_position = 1
texture = ExtResource("4_id27c")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_g4m7r"]
script = ExtResource("1_3b1jx")
name = "旁白"
description = "他竟亲自离座，走到你面前。那双翻手为云覆手为雨的手，重重地、却又极具温度地拍了拍你的肩膀。"
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

[sub_resource type="Resource" id="Resource_kivvs"]
script = ExtResource("1_3b1jx")
name = "李林甫"
description = "天下，太需要你这样的年轻人了。回去好好歇息，无需再四处奔波受气。明年的春闱科举，老夫要在紫宸殿的金榜上，看到你的名字"
chat_position = 1
texture = ExtResource("2_sndk8")
metadata/_custom_type_script = "uid://dsb2koxwa7ypp"

