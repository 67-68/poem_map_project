[gd_resource type="Resource" script_class="RandomEvent" format=3 uid="uid://btleverageadd01"]

[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="1_leverage"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="2_leverage"]
