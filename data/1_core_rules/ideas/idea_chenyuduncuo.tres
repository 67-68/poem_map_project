[gd_resource type="Resource" script_class="Idea" format=3]

[ext_resource type="Script" path="res://core/idea.gd" id="1"]
[ext_resource type="Script" path="res://core/buff_operator.gd" id="2"]
[ext_resource type="Script" path="res://core/multi_buff_operator.gd" id="3"]
[ext_resource type="Script" path="res://core/requirements/action_match_requirement.gd" id="4"]

[sub_resource type="Resource" id="Resource_cond_shaoling"]
script = ExtResource("4")
action_id = "denggao_shaolingyuan"

[sub_resource type="Resource" id="Resource_buff_l0"]
script = ExtResource("2")
named_amount_key = "l_mod_pct"
modifier_type = "action_specific"
condition = SubResource("Resource_cond_shaoling")

[sub_resource type="Resource" id="Resource_buff_l1_eff"]
script = ExtResource("2")
named_amount_key = "m_mod_pct"
modifier_type = "efficiency"

[sub_resource type="Resource" id="Resource_buff_l1_cap"]
script = ExtResource("2")
named_amount_key = "m_mod_pct"
modifier_type = "cap_boost"

[sub_resource type="Resource" id="Resource_multi_l1"]
script = ExtResource("3")
buffs = Array[ExtResource("2")]([SubResource("Resource_buff_l1_eff"), SubResource("Resource_buff_l1_cap")])

[resource]
script = ExtResource("1")
uuid = "idea_chenyuduncuo"
name = "TRES_IDEA_CHENYUDUNCUO_NAME_0"
description = "TRES_IDEA_CHENYUDUNCUO_DESCRIPTION_0"
idea_buffs = Array[ExtResource("2")]([SubResource("Resource_buff_l0"), SubResource("Resource_multi_l1")])
current_idea_level = -1
idea_demonstrations = Array[String](["TRES_IDEA_CHENYUDUNCUO_IDEA_DEMONSTRATIONS_0", "TRES_IDEA_CHENYUDUNCUO_IDEA_DEMONSTRATIONS_1"])
idea_cost_name = "inspiration"
idea_cost_amount = 50
counter_idea = "idea_chizibaiyi"
