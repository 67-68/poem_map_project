[resource]
script = ExtResource("1_note")
uuid = "note_fangshi_chuyou_health"
name = "坊市-出游循环"
description = "朝扣富儿门，暮随肥马尘。残杯与冷炙，到处潜悲辛。"
description_explanation = "清晨去敲富豪的大门，傍晚随在达官贵人的马后吃尘土；吃的是别人的残羹冷炙，到处偷偷吞咽着悲伤与痛苦。即使如此的下贱，但仍然吃不上饭。"
note_narrative = "昔年泰山清狂，不知薪米之贵；今入长安，方知出卖体力之迫切也。"
note_explanation = "去【坊市】行动出卖体力之后去【出游】可以有效获取生命。"
triggered = false
requirement = SubResource("SubReq")
