options = Array[ExtResource("1_uwksu")]([SubResource("Resource_ce8pd")])
uuid = "bai_ye_honeymoon_l0_typea_m1"
name = "名帖三翻"
description = "黄昏时分，你站在某部衙门侧门前，递上名帖。那门子接过名帖，却不急着看，先上下打量你一番。他慢慢翻开名帖，拇指在纸页边缘来回搓动，发出沙沙声响。你等了片刻，他仍不抬头，只是反复翻看那薄薄一页，仿佛上面有千百字需要辨认。秋风渐起，檐角铁马叮当，你衣袍被吹得猎猎作响。门子终于抬眼，目光从你脸上滑到你的袖口，又落回名帖上，拇指搓动的动作并未停下。他身后门房里透出暖黄灯火，隐约有茶香飘出，却无丝毫为你让路的意思。"
