[resource]
script = ExtResource("9_ydygi")
requirement = SubResource("Resource_ahtua")
era = "745_ambition"
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_jv8p8")]([SubResource("Resource_i6lvq")])
uuid = "bai_ye_honeymoon_l0_typeb_m2"
name = "寒门候茶"
description = "“尚书大人正与几位侍郎议事，你且在此处候着。”他指了指门廊下风口处，便转身回了门房。约莫两刻钟后，门子推开一条门缝，递出一碗热茶，又缩了回去。茶碗滚烫，你双手捧着，寒风里，那热意只暂时暖了掌心，四肢仍冰冷。门内传来门子与同伴的低语声，隐约听得“新来的进士总是这般急”一句，旋即被炭火拨弄的声响淹没。"
