[resource]
script = ExtResource("12_ccrs3")
requirement = SubResource("Resource_pp67b")
era = "745_ambition"
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_jtq6f")]([SubResource("Resource_d8ga7"), SubResource("Resource_qsun8")])
uuid = "bai_ye_real_appearance_l1_typeb"
name = "朱批与苔痕"
description = "年兄这'京华'二字犯忌,'孤鸿'之典僭越了.还有这句不通,失当,当改.旁边一人踱步时踩住你长衫的衣角,又从案上抽走那张你觉得最得意的句子,递到窗下念给旁人听——当个笑话.你执笔,按批注逐一删改.指节叩桌,韵律在指下被重新填平.末了,那清客点头,指腹抹过墨迹新鲜的字句,将诗稿合上,递还于你.篇什四平八稳,韵脚工整如尸,却出了他这间值房."
