[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/event/base_option.gd" id="1_baseopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="3_propop"]
[ext_resource type="Script" path="res://core/operators/emotion_operator.gd" id="4_emoop"]
[ext_resource type="Script" path="res://core/model/trait_operator.gd" id="5_traitop"]
[ext_resource type="Script" path="res://core/operators/info_demo_operator.gd" id="6_infoop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="7_choiceresult"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="8_eventopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="9_randomevent"]

[sub_resource type="Resource" id="Resource_health30"]
script = ExtResource("3_propop")
str_props = "health"
value = 30

[sub_resource type="Resource" id="Resource_emo_ambition0"]
script = ExtResource("4_emoop")
_emotion = 4
value = 0
mode = "set"

[sub_resource type="Resource" id="Resource_official_minus30"]
script = ExtResource("3_propop")
str_props = "official_prestige"
value = -30

[sub_resource type="Resource" id="Resource_trait_broken"]
script = ExtResource("5_traitop")
str_traits = "near_death_mind_broken"

[sub_resource type="Resource" id="Resource_info_sing"]
script = ExtResource("6_infoop")
info = "你的身体涌出一股热流，但某种东西永远地碎了。"

[sub_resource type="Resource" id="Resource_cr"]
script = ExtResource("7_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_health30"), SubResource("Resource_emo_ambition0"), SubResource("Resource_official_minus30"), SubResource("Resource_trait_broken"), SubResource("Resource_info_sing")])

[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("8_eventopt")
choice_result = SubResource("Resource_cr")
description = "沉饮聊自遣，放歌破愁绝"

[resource]
script = ExtResource("9_randomevent")
_action_tags = Array[int]([])
options = Array[ExtResource("1_baseopt")]([SubResource("Resource_option")])
uuid = "near_death_sing_crazy"
name = "狂歌破愁绝"
description = "极度的寒冷让你产生了幻觉，长安的繁华像走马灯一样在你眼前闪烁。你突然在风雪里狂笑起来，嘶哑的嗓音被风撕碎。你的身体不可思议地涌出一股热流，但你脑海中关于长安的最后一点体面，也跟着这声狂笑一起死去了。"
