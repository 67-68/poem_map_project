_target_tags = Array[String](["ENV_SOCIETY_FAMINE:starving_bone", "TARGET_NPC_DUFU:thatched_grass", "action:main:ganlu", "TARGET_IDENTITY_POOR"])
options = Array[ExtResource("1_oqrhk")]([SubResource("Resource_e8f8c"), SubResource("Resource_0c17b")])
uuid = "ganlu_journey_scene_refugee_identity_poor"
name = "冰辙压雪"
description = "官道积雪未化，冻土裂出细纹。远处一个模糊轮廓蹲在道旁，背对风来的方向，膝盖上摊着半块干饼。马队蹄声先于影子抵达——碎冰从冻土上炸开，六匹快马并排碾过，颈下红绸被风扯成直线。那个轮廓侧翻进深沟，干饼落在路面上被蹄铁踏成粉末。骑手过完最后一匹时，沟底没有声音。风重新把雪末吹上路面，盖住饼屑。"
