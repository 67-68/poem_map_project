[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/event/base_option.gd" id="1_baseopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" path="res://core/operators/info_demo_operator.gd" id="3_infoop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="4_choiceresult"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="5_eventopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="6_randomevent"]

[sub_resource type="Resource" id="Resource_info_nothing"]
script = ExtResource("3_infoop")
info = "什么都没有发生。"

[sub_resource type="Resource" id="Resource_cr"]
script = ExtResource("4_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_info_nothing")])

[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("5_eventopt")
choice_result = SubResource("Resource_cr")
description = "......"

[resource]
script = ExtResource("6_randomevent")
_action_tags = Array[int]([])
options = Array[ExtResource("1_baseopt")]([SubResource("Resource_option")])
uuid = "near_death_nothing_to_burn"
name = "無物可燒"
description = "你翻遍了全身，没有纸，没有酒，甚至连悲哀和愤怒的情绪都已被榨干。大唐已经没有什么东西可以让你拿来燃烧了。"
