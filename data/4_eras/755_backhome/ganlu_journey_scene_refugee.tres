[resource]
script = ExtResource("9_g4m0x")
era = "755_backhome"
_target_tags = Array[String](["action:main:ganlu"])
options = Array[ExtResource("1_odayg")]([SubResource("Resource_ro7me"), SubResource("Resource_fs38q")])
uuid = "ganlu_journey_scene_refugee"
name = "冰辙压雪"
description = "官道积雪未化，冻土裂出细纹。远处一个模糊轮廓蹲在道旁，背对风来的方向，膝盖上摊着半块干饼。马队蹄声先于影子抵达——碎冰从冻土上炸开，六匹快马并排碾过，颈下红绸被风扯成直线。那个轮廓侧翻进深沟，干饼落在路面上被蹄铁踏成粉末。骑手过完最后一匹时，沟底没有声音。风重新把雪末吹上路面，盖住饼屑。"
