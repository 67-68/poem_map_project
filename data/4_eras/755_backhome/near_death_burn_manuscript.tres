[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/event/base_option.gd" id="1_baseopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="3_propop"]
[ext_resource type="Script" path="res://core/operators/info_demo_operator.gd" id="4_infoop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="5_choiceresult"]
[ext_resource type="Script" path="res://core/model/poem_taste.gd" id="6_poemtaste"]
[ext_resource type="Script" path="res://core/operators/trait_choose_operator.gd" id="7_chooseop"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="8_eventopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="9_randomevent"]

[sub_resource type="Resource" id="Resource_health15"]
script = ExtResource("3_propop")
str_props = "health"
value = 15

[sub_resource type="Resource" id="Resource_info_burn"]
script = ExtResource("4_infoop")
info = "TRES_NEAR_DEATH_BURN_MANUSCRIPT_INFO_0"

[sub_resource type="Resource" id="Resource_health10"]
script = ExtResource("3_propop")
str_props = "health"
value = 10

[sub_resource type="Resource" id="Resource_info_nothing"]
script = ExtResource("4_infoop")
info = "TRES_NEAR_DEATH_BURN_MANUSCRIPT_INFO_1"

[sub_resource type="Resource" id="Resource_accepted_cr"]
script = ExtResource("5_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_health15"), SubResource("Resource_info_burn")])

[sub_resource type="Resource" id="Resource_not_entered_cr"]
script = ExtResource("5_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_health10"), SubResource("Resource_info_nothing")])

[sub_resource type="Resource" id="Resource_rejected_cr"]
script = ExtResource("5_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_health10"), SubResource("Resource_info_nothing")])

[sub_resource type="Resource" id="Resource_poem_taste"]
script = ExtResource("6_poemtaste")
uuid = "poem_taste_near_death_burn"
_accepted_poem_types = Array[int]([0, 1, 2, 3, 4, 5])
accepted_result = SubResource("Resource_accepted_cr")
rejected_result = SubResource("Resource_rejected_cr")
not_entered_result = SubResource("Resource_not_entered_cr")

[sub_resource type="Resource" id="Resource_choose_op"]
script = ExtResource("7_chooseop")
poem_taste = SubResource("Resource_poem_taste")
key_to_get_poem_taste = ""

[sub_resource type="Resource" id="Resource_option_cr"]
script = ExtResource("5_choiceresult")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_choose_op")])

[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("8_eventopt")
choice_result = SubResource("Resource_option_cr")
description = "TRES_NEAR_DEATH_BURN_MANUSCRIPT_DESCRIPTION_0"

[resource]
script = ExtResource("9_randomevent")
_action_tags = Array[int]([])
options = Array[ExtResource("1_baseopt")]([SubResource("Resource_option")])
uuid = "near_death_burn_manuscript"
name = "TRES_NEAR_DEATH_BURN_MANUSCRIPT_NAME_0"
description = "TRES_NEAR_DEATH_BURN_MANUSCRIPT_DESCRIPTION_1"
