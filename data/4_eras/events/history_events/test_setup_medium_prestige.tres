[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("5_evopt")
choice_result = SubResource("Resource_choice")
description = "设置望=100 → medium ending (望≥100)"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("2_baseev")
options = Array[ExtResource("1_opt")]([SubResource("Resource_option")])
uuid = "test_setup_medium_prestige"
name = "测试: 中等结局条件 (望=100)"
description = "设置 prestige=100，触发 medium ending 所需条件"
