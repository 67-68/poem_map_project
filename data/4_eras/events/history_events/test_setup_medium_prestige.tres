[gd_resource type="Resource" script_class="BaseEvent" format=3 uid="uid://test_setup_medium_01"]

[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="1_opt"]
[ext_resource type="Script" uid="uid://cpb80yg1s313y" path="res://model/event.gd" id="2_baseev"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" uid="uid://wotbd0ebjf13" path="res://core/operators/force_set_property_operator.gd" id="3_fset"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="4_result"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="5_evopt"]

[sub_resource type="Resource" id="Resource_fset_pre"]
script = ExtResource("3_fset")
_property = 2
value = 100

[sub_resource type="Resource" id="Resource_choice"]
script = ExtResource("4_result")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_fset_pre")])
