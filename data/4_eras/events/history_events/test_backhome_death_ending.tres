[gd_resource type="Resource" script_class="BaseEvent" format=3 uid="uid://test_backhome_death_01"]

[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="1_opt"]
[ext_resource type="Script" uid="uid://cpb80yg1s313y" path="res://model/event.gd" id="2_baseev"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" uid="uid://wotbd0ebjf13" path="res://core/operators/force_set_property_operator.gd" id="3_fset"]
[ext_resource type="Script" uid="uid://clkjr0fnn00vd" path="res://core/operators/flag_operator.gd" id="4_flagop"]
[ext_resource type="Script" uid="uid://cxfcnsval1p54" path="res://core/operators/push_event_operator.gd" id="5_push"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="6_result"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="7_evopt"]

[sub_resource type="Resource" id="Resource_fset_health"]
script = ExtResource("3_fset")
_property = 1
value = 1

[sub_resource type="Resource" id="Resource_flag_ndeath"]
script = ExtResource("4_flagop")
flag_id = "flag_near_death_count"
type = "int"
value = 3

[sub_resource type="Resource" id="Resource_push_death"]
script = ExtResource("5_push")
event_key = "event_backhome_ending_death"
metadata/_custom_type_script = "uid://cxfcnsval1p54"

[sub_resource type="Resource" id="Resource_choice"]
script = ExtResource("6_result")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_fset_health"), SubResource("Resource_flag_ndeath"), SubResource("Resource_push_death")])
metadata/_custom_type_script = "uid://prpfdj2ag46k"

[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("7_evopt")
choice_result = SubResource("Resource_choice")
description = "设置生命=1 + near_death=3 + 推入死亡结局"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("2_baseev")
options = Array[ExtResource("1_opt")]([SubResource("Resource_option")])
uuid = "test_backhome_death_ending"
name = "测试: 死亡结局「冻毙于风雪」"
description = "force_set health=1, set flag_near_death_count=3, 直接推入 event_backhome_ending_death"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
