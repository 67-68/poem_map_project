[gd_resource type="Resource" script_class="BaseEvent" format=3 uid="uid://test_backhome_historical_01"]

[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="1_opt"]
[ext_resource type="Script" uid="uid://cpb80yg1s313y" path="res://model/event.gd" id="2_baseev"]
[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" uid="uid://wotbd0ebjf13" path="res://core/operators/force_set_property_operator.gd" id="3_fset"]
[ext_resource type="Script" uid="uid://dp5gqdkppjq17" path="res://core/model/trait_operator.gd" id="4_traitop"]
[ext_resource type="Script" uid="uid://clkjr0fnn00vd" path="res://core/operators/flag_operator.gd" id="5_flagop"]
[ext_resource type="Script" uid="uid://cxfcnsval1p54" path="res://core/operators/push_event_operator.gd" id="6_push"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="7_result"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="8_evopt"]

[sub_resource type="Resource" id="Resource_fset_progress"]
script = ExtResource("3_fset")
_property = 4
value = 100

[sub_resource type="Resource" id="Resource_trait_add_rattle"]
script = ExtResource("4_traitop")
str_traits = "rattle_drum"

[sub_resource type="Resource" id="Resource_flag_witnessed"]
script = ExtResource("5_flagop")
flag_id = "flag_witnessed_lishan_corpses"
type = "bool"
value = true

[sub_resource type="Resource" id="Resource_push_router"]
script = ExtResource("6_push")
event_key = "event_backhome_ending_router"
metadata/_custom_type_script = "uid://cxfcnsval1p54"

[sub_resource type="Resource" id="Resource_choice"]
script = ExtResource("7_result")
operators = Array[ExtResource("2_baseop")]([SubResource("Resource_fset_progress"), SubResource("Resource_trait_add_rattle"), SubResource("Resource_flag_witnessed"), SubResource("Resource_push_router")])
metadata/_custom_type_script = "uid://prpfdj2ag46k"

[sub_resource type="Resource" id="Resource_option"]
script = ExtResource("8_evopt")
choice_result = SubResource("Resource_choice")
description = "设置进度=100 + 添加拨浪鼓 + 设置目击冻死骨 + 推入结局路由"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("2_baseev")
options = Array[ExtResource("1_opt")]([SubResource("Resource_option")])
uuid = "test_backhome_historical_ending"
name = "测试: 历史线结局「文章憎命达」"
description = "force_set progress=100, 添加拨浪鼓, 设 flag_witnessed_lishan_corpses=true（目睹冻死骨）, 推入 event_backhome_ending_router → 路由到真·历史结局"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
