options = Array[ExtResource("1_731ra")]([SubResource("Resource_y1xut"), SubResource("Resource_flrwq"), SubResource("Resource_p7ih8")])
uuid = "qingliu_passive_benefits_wangwei_silent_bailout"
name = "法物流通处"
description = "大慈恩寺的法物流通处里，王维与你并肩站了许久。他在《金刚经》抄本前停下，未曾开口，只将一件厚实的棉袍搁在你臂弯上——“买重了。”语气如谈论今日风大一般平淡。你认得这件袍子，是方才寺门外那个辽东皮货商担来的。王维转身去付抄经的银钱，袍子就这么留在你手中，一言未再多说。"
