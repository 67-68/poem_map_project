[resource]
script = ExtResource("9_qgwon")
requirement = SubResource("Resource_joyoj")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_aid"])
options = Array[ExtResource("1_lpvb2")]([SubResource("Resource_mjmk0"), SubResource("Resource_sguny"), SubResource("Resource_j5jjb")])
uuid = "qingliu_passive_benefits_gaoshi_silent_bailout"
name = "错买的冬衣"
description = "高适从河西回长安述职，路过下杜城时在街口截住你。他拎着一件羊皮袄子，说是给军中袍泽带的，结果尺码错了退不了——“你试试，穿不上我就扔了。”袄子大了一号，裹在你瘦削的身板上，正够塞进一件旧棉衣。他说完便走，头也不回。你站在巷口，手里攥着这张羊皮，风灌不进去了。"
