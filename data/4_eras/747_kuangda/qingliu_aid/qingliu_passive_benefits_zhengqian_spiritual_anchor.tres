[resource]
script = ExtResource("9_8mwbn")
requirement = SubResource("Resource_8cpk4")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_aid"])
options = Array[ExtResource("1_nubhd")]([SubResource("Resource_ndwum"), SubResource("Resource_ktiqi"), SubResource("Resource_auo7r")])
uuid = "qingliu_passive_benefits_zhengqian_spiritual_anchor"
name = "菜市口旧稿"
description = "春晨下杜城菜市口，郑虔从人潮中挤出来拦住你，从怀里掏出一卷被油渍浸透的旧稿——去岁你丢进灶膛的那卷，被他从火口抢了回来。他什么也没说，只是把那卷纸塞进你手里，转身便走。纸张边缘焦痕犹在，烟熏味混着菜市的葱韭气息。"
