[resource]
script = ExtResource("9_dvogo")
requirement = SubResource("Resource_02reg")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_aid"])
options = Array[ExtResource("1_frgc4")]([SubResource("Resource_exvj6"), SubResource("Resource_a8s2f"), SubResource("Resource_glyyp")])
uuid = "qingliu_passive_benefits_libai_spiritual_anchor"
name = "沙上剑书"
description = "天宝十三载秋，李白过下杜城。他醉了，没叩你的门。后来有人在渭水边的沙地上看见一行字——是用剑尖划出的“杜子美”三字，歪斜潦草，旁边散落着马蹄印，延伸向潼关方向。那人来告诉你时，沙上的字迹已被风吹浅了一半。"
