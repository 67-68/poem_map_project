era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_5jbbg")]([SubResource("Resource_4v6bg")])
uuid = "kuangke_qingliu_zhengqian_emotion_anger"
name = "井台上的愤懑"
description = "广文馆后院，郑虔把一摞学生默写的诗卷摔在井台上，井绳晃了两晃。碎纸从捆扎处崩开，散了一地。「错别字比对的还多——有个学生把『烽火』写成了『峰火』，我怎么教的？」他用拇指和中指掐着鼻梁，掌根压住眼睛，把一卷皱巴巴的纸往你怀里塞，「你看看，你自己看。」纸上的墨迹洇了水，字都鼓着毛边。郑虔的手腕在抖。"
