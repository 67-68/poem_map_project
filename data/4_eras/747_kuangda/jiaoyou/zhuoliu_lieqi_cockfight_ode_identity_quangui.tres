[resource]
script = ExtResource("11_l0grx")
requirement = SubResource("Resource_8d0fj")
era = "747_kuangda"
_target_tags = Array[String](["TARGET_FACTION_ROYAL:jade_step", "ACTION_ENTERTAIN_DRINK:empty_cup", "action:main:jiaoyou", "TARGET_IDENTITY_QUANGUI"])
options = Array[ExtResource("1_ahsqg")]([SubResource("Resource_sjo5f"), SubResource("Resource_5x453"), SubResource("Resource_w1r7l")])
uuid = "zhuoliu_lieqi_cockfight_ode_identity_quangui"
name = "斗鸡坊的诗价"
description = "脂粉味和荔枝的甜腻混在一起，把空气搅成黏稠的浆。紫袍胖子靠在锦垫上，三根手指捏着剥好的荔枝，汁水沿指缝往下走，滴在袍子上洇出深色的印。一个家丁的手不知什么时候扣住了你的肘弯，指节收紧时你听见自己袖口的布料发出绷紧的声响。胖子没转头。他用下巴朝角落指了一下——地上铺着一张毡垫，垫子上几根鸡毛粘在干涸的湿痕边缘。“杜审言的孙子？正好。”他把荔枝核吐在歌伎递来的银盘里，“我这鸡刚赢三场，缺一首压轴的。你坐那写。”歌伎中的一个用扇子掩了嘴，眼睛从你脸上扫到毡垫上那摊湿痕，扇子后面有气音漏出来。"
