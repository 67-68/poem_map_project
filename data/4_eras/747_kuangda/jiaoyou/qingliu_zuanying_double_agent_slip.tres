[resource]
script = ExtResource("10_ewamr")
requirement = SubResource("Resource_adq37")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_viv55")]([SubResource("Resource_ewamr"), SubResource("Resource_lholq"), SubResource("Resource_ts6t0")])
uuid = "qingliu_zuanying_double_agent_slip"
name = "飞白书痞"
description = "雅集设在一处退隐御史的别院。帖子是三天前涂敏之递来的——你认得那人的小楷，但帖上写的名字不是你。进门时你看到六个人围坐在一张黄杨木案四侧。案上摊着一封拜帖，纸是熟宣，墨是松烟。众人正就那字迹讲笑话——有人模仿落款处的“伏惟叩首”，有人数一张帖中用了几个“恩”字。笑声到一半，一个穿靛青长衫的中年人把帖子翻了过去，露出背面写的两句歪诗。飞白体的收笔向右上翘，翘的方式太熟悉了。涂敏之放下茶盏，往你座位的方向看了一眼，帘子还没掀，脚步声已经停了。"
