[resource]
script = ExtResource("7_w4v8j")
era = "747_kuangda"
_target_tags = Array[String](["action:humiliation_talent_commodification", "action:scene_jiaoyou"])
options = Array[ExtResource("1_afyva")]([SubResource("Resource_7anrp"), SubResource("Resource_fhqoy"), SubResource("Resource_cjykg")])
uuid = "duotai_humiliation_talent_commodification_gateway_jiaoyou_identity_qingliu_official"
name = "酒宴索诗"
description = "“子美兄，我家老爷子过寿，你帮写首祝寿诗吧——不用太认真，热闹喜庆就行。”他笑着松手，从袖中取出一张宣纸和一支笔，搁在你面前的桌角上。周围的谈笑声微微停顿了一瞬，又继续起来——有人瞥了一眼你身上的旧袍，转头继续敬酒。"
