_target_tags = Array[String](["TARGET_NPC_LIBAI:wine_gourd", "TARGET_IDENTITY_QINGLIU_OWNER", "ACTOR_EMOTION_ARROGANCE", "emotion_pair:pair_arrogance", "action:main:jiaoyou"])
