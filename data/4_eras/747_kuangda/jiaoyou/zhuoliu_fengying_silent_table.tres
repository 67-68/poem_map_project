[resource]
script = ExtResource("12_k20xj")
requirement = SubResource("Resource_8x18q")
era = "747_kuangda"
_target_tags = Array[String](["TARGET_NPC_DUFU:thatched_grass", "ACTION_ENTERTAIN_DRINK:empty_cup", "action:main:jiaoyou"])
options = Array[ExtResource("1_gbyqw")]([SubResource("Resource_w1lv1"), SubResource("Resource_0itws"), SubResource("Resource_6dnws")])
uuid = "zhuoliu_fengying_silent_table"
name = "二两碎银换来的陪坐"
description = "门帘掀开半幅，薛家管事站在槛外没进来。他将二两碎银搁在桌上——纸包摊开，糙纸上还粘着昨夜的油渍。“明晚有个小宴，请先生来添点文气。”你到的时候发现座位在最下手，离门最近，离炉子最远。离你最近的那道菜端上来时就已经凉了。薛三郎坐在上首，跟身旁的人聊着你上次替他润色的那篇碑文——他不记得你叫什么，他叫你“上次那个人”。"
