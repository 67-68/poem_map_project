[resource]
script = ExtResource("13_5lldq")
requirement = SubResource("Resource_t26te")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_lfnbm")]([SubResource("Resource_6r2n5"), SubResource("Resource_ys85w"), SubResource("Resource_3k1cx")])
uuid = "zhuoliu_fengying_silent_table"
name = "二两碎银换来的陪坐"
description = "门帘掀开半幅，薛家管事站在槛外没进来。他将二两碎银搁在桌上——纸包摊开，糙纸上还粘着昨夜的油渍。“明晚有个小宴，请先生来添点文气。”你到的时候发现座位在最下手，离门最近，离炉子最远。离你最近的那道菜端上来时就已经凉了。薛三郎坐在上首，跟身旁的人聊着你上次替他润色的那篇碑文——他不记得你叫什么，他叫你“上次那个人”。"
