[resource]
script = ExtResource("8_s5b7p")
requirement = SubResource("Resource_yfjnd")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_3c4o5")]([SubResource("Resource_waxb6")])
uuid = "qingliu_daoxin_posui_poverty_as_aesthetic"
name = "举杯饮寒酸"
description = "绯袍官员举杯时，酒液在杯口溢出一道细痕。他说子美兄的贫寒是真的，语气像是在介绍一道菜的做法。席上几个青袍官员纷纷侧身看过来。有人指着你领口的补丁说这是真风骨，说完夹了一块羊肉。你低头看袖口的磨痕。那块磨损处今天早上还没有发白。酒杯搁在唇边，酒气涌上来，酒液却迟迟没有入口。"
