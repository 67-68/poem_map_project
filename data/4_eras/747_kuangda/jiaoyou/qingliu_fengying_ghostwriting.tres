[resource]
script = ExtResource("13_regru")
requirement = SubResource("Resource_7rusb")
era = "747_kuangda"
archetype_id = "jiaoyou"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:ink_stone", "TARGET_NPC_DUFU:thatched_grass", "action:main:jiaoyou"])
options = Array[ExtResource("1_ot2cc")]([SubResource("Resource_q4an7"), SubResource("Resource_lnenw"), SubResource("Resource_8jy1r")])
uuid = "qingliu_fengying_ghostwriting"
name = "席间纸笔"
description = "酒过三巡，郑家公子从袖中摸出叠得齐整的纸，铺在湿漉漉的桌面上。“上回那首《秋兴》改得好，家父逢人便夸。”他替你斟满酒，推过来，“今日再劳烦一回。”席上无人抬眼——他们都记得上次雅集，你替这位公子的诗润色了整整一个时辰。现下纸笔已备好，砚台也摆在你手边。那支笔的笔锋微秃，正是你上次落在郑家的。"
