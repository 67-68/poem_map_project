[resource]
script = ExtResource("14_7rusb")
requirement = SubResource("Resource_4b8h2")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_auryo")]([SubResource("Resource_k32fo"), SubResource("Resource_8ceta"), SubResource("Resource_6ayjm")])
uuid = "qingliu_fengying_ghostwriting"
name = "席间纸笔"
description = "酒过三巡，郑家公子从袖中摸出叠得齐整的纸，铺在湿漉漉的桌面上。“上回那首《秋兴》改得好，家父逢人便夸。”他替你斟满酒，推过来，“今日再劳烦一回。”席上无人抬眼——他们都记得上次雅集，你替这位公子的诗润色了整整一个时辰。现下纸笔已备好，砚台也摆在你手边。那支笔的笔锋微秃，正是你上次落在郑家的。"
