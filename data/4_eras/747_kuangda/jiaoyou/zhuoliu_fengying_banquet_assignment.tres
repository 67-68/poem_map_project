[resource]
script = ExtResource("13_pgs58")
requirement = SubResource("Resource_d1m7n")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_ts7po")]([SubResource("Resource_oxreu"), SubResource("Resource_b7scu"), SubResource("Resource_2p7p4")])
uuid = "zhuoliu_fengying_banquet_assignment"
name = "酒过三巡叩指时"
description = "半桌人停了筷子。主位的椅子腿刮过青砖——往你这边挪了两寸，没转头看你，但挪椅子的声响让整间屋子都静了一息。你桌前的酒盏刚被人斟满，杯沿还挂着上一巡的油花。主位的手指在桌面叩了两下，像在计时。“写喜庆点，”他说，“上回那首太苦了。”他没提上回是哪回——但你记得，上回替他远房侄子的诗文润色时，他说的也是这句。"
