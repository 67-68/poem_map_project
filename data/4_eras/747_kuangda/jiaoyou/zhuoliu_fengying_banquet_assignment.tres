[resource]
script = ExtResource("13_pgs58")
requirement = SubResource("Resource_tnn8j")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_ts7po")]([SubResource("Resource_o7lbd"), SubResource("Resource_1q7va"), SubResource("Resource_ebh5r")])
uuid = "zhuoliu_fengying_banquet_assignment"
name = "残羹尚温"
description = "他挪椅子的声响让半桌人停了筷。你面前那碟羊羹已经凝出白油——酒过三巡，该来的总是会来。他往你这边挪了半寸，没看你，手指在桌上叩了两下。「写喜庆点，」他说，「上回那首太苦了。」上次他离你这么近时，你替他的门客捉刀了一篇给谏议大夫的贺表。润笔你收了，所以这次他连客套都省了。"
