[resource]
script = ExtResource("9_dmpyr")
requirement = SubResource("Resource_iwbj7")
era = "747_kuangda"
_target_tags = Array[String](["TARGET_FACTION_ROYAL:jade_step", "VIBE_AESTHETIC_ELEGANT:giant_roc", "action:main:jiaoyou"])
options = Array[ExtResource("1_ti1vi")]([SubResource("Resource_fjefd"), SubResource("Resource_psu86"), SubResource("Resource_u06u4")])
uuid = "zhuoliu_zuanying_dinner_party_broker"
name = "酒宴上的旧账"
description = "“子美兄，我有个同僚想见户部的人。价钱好说。”说这话时他的眼睛没看你，看的是你身后那扇门——门后是今日宴席上所有正在交易的秘密。他笃定你还在这张桌上。"
