[resource]
script = ExtResource("10_3anpu")
requirement = SubResource("Resource_lac6s")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:giant_roc", "TARGET_FACTION_ROYAL:jade_step", "action:main:jiaoyou"])
options = Array[ExtResource("1_3pbra")]([SubResource("Resource_6g0yd"), SubResource("Resource_2qjxu"), SubResource("Resource_bgkby")])
uuid = "qingliu_zuanying_monetized_guest_list"
name = "席上少了一行姓名"
description = "雅集后第三日，一封谢柬送到。清流主人写给另一位常客的信，信中历数那日席上“尽皆佳士”，列了四个人的名字。你带了五个人来。被略掉的那个是商人——他的茧子太厚、端盏时小指翘得过了、对一幅南唐摹本说了“这纸真新”——当时只有主人皱了一下眉。现在那封谢柬摊在桌上，墨迹干透。你没有被点名指责，你只是看见那行漏掉的名字像一颗拔掉的牙。"
