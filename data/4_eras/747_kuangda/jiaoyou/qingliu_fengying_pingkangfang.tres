[resource]
script = ExtResource("12_y1c46")
requirement = SubResource("Resource_oo5ow")
era = "747_kuangda"
_target_tags = Array[String](["TARGET_FACTION_ROYAL:jade_step", "VIBE_AESTHETIC_ELEGANT:ink_stone", "action:main:jiaoyou"])
options = Array[ExtResource("1_eq3wv")]([SubResource("Resource_bdsia"), SubResource("Resource_q65p2"), SubResource("Resource_fi505")])
uuid = "qingliu_fengying_pingkangfang"
name = "平康坊闭门羹"
description = "“哟，杜先生又来了。”那个“又”字咬得轻，但很准。楼上的丝竹声灌下来，她侧身挡着门，下巴朝坊墙边的小杌子一抬：“写首艳词，写好了让你进去。”语气像在吩咐一个熟客——一个不用客气的熟客。"
