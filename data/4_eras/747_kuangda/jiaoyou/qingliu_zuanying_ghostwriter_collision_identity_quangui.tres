[sub_resource type="Resource" id="Resource_cccxe"]
script = ExtResource("7_cnjny")
choice_result = SubResource("Resource_twiyv")
description = "欠身拿起两张诗笺端详，顺着韵脚往下比对，评了一句“第三字若用去声会更稳”，把话题转向用典。"

