_target_tags = Array[String](["ACTION_ENTERTAIN_DRINK:cloud_and_sun", "TARGET_NPC_DUFU:ink_for_sale", "action:main:jiaoyou", "TARGET_IDENTITY_QUANGUI"])
options = Array[ExtResource("1_j63h2")]([SubResource("Resource_euncq"), SubResource("Resource_vkwqj"), SubResource("Resource_hk3wp")])
uuid = "qingliu_zuanying_ghostwriter_collision_identity_quangui"
name = "韵脚撞车"
description = "“近日坊间传抄的，说是某公子新作，你们品品这句——‘孤舟系在楚云根’。”你握着酒杯的手指未动。王参军接过去看了看，却从自己行囊里翻出另一卷残稿：“巧了，去年子美送我的干谒诗里，也有一联‘独木横于湘水湄’。这押韵的路数，倒是如出一辙。”他把两张诗笺并排放在案上，笔画不清，但韵脚的骨架——仄起平收、第五字必用入声——两首诗像同一只手在打拍子。陈明府的眼睛眯了起来，转向你看了一眼，什么也没问。他在等。"
