[sub_resource type="Resource" id="Resource_rwi6q"]
script = ExtResource("8_vkwqj")
choice_result = SubResource("Resource_hlftv")
description = "欠身拿起两张诗笺端详，顺着韵脚往下比对，评了一句“第三字若用去声会更稳”，把话题转向用典。"

[sub_resource type="Resource" id="Resource_4jxnw"]
