[resource]
script = ExtResource("10_54edx")
requirement = SubResource("Resource_7qdt6")
era = "747_kuangda"
_target_tags = Array[String](["action:main:jiaoyou"])
options = Array[ExtResource("1_ccb6t")]([SubResource("Resource_lywtj"), SubResource("Resource_jgx27"), SubResource("Resource_26l7b")])
uuid = "zhuoliu_zuanying_intelligence_commodity"
name = "茶案上的价码"
description = "东市茶肆二楼临窗的位置，一个绸缎商把一张纸条推过案面。纸上只写着一个官员的名字，墨迹已干。他将茶碗搁在纸条旁边，碗底在纸上压出一圈湿痕。“上次你在盐商老张那儿‘问’的事，我听说过。”目光越过碗沿，不紧不慢地看着你，“我不是来为难你的。我也是来做生意的。”窗外楼下，东市的骡马队正在卸货，鞭子抽在青石板上的声响传上来。绸缎商从袖口又抽出一张叠好的纸，“这是价钱。你看看。”"
