[sub_resource type="Resource" id="Resource_ad1b0"]
script = ExtResource("8_cdjo8")
choice_result = SubResource("Resource_icvnq")
description = "欠身拿起两张诗笺端详，顺着韵脚往下比对，评了一句“第三字若用去声会更稳”，把话题转向用典。"

[sub_resource type="Resource" id="Resource_muf1x"]
