trait_name = "kuangda_zuanying"

[resource]
script = ExtResource("9_1npjw")
requirement = SubResource("Resource_ye8cc")
era = "747_kuangda"
_target_tags = Array[String](["ACTION_ENTERTAIN_DRINK:cloud_and_sun", "TARGET_NPC_DUFU:jade_step", "action:main:jiaoyou"])
options = Array[ExtResource("1_7uepq")]([SubResource("Resource_e617q"), SubResource("Resource_0ki7p"), SubResource("Resource_avqdn")])
uuid = "qingliu_zuanying_triple_dipped_suffering"
name = "冬至对账"
description = "“九月十三，子美来书，言天寒无炭。”张参军放下酒杯：“巧了，我也是九月十三收到的。”他顿了顿，“他在信里说孩子咳了一冬。”李司仓没收到信——但他记得那个日子。那天他在朱雀街东口碰见你，你拉住他的袖子，说老母病重，等钱抓药。三人在炉边沉默了。崔九把那页日记摊在桌上，手指点着日期：“九月十三……你这一天，挺忙的。”火光照着那一行字，墨迹已经褪成灰褐色。"
