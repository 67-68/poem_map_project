era = "747_kuangda"
_target_tags = Array[String](["kuangke_qingliu"])
options = Array[ExtResource("1_xd7l8")]([SubResource("Resource_3efie")])
uuid = "kuangke_qingliu_libai_emotion_arrogance"
name = "墙头掷诗"
description = "黄昏时分，李白蹲在下杜城你陋室的矮墙头上，像只鹞子。他从怀里掏出一卷纸扔下来，纸卷撞在地上弹了一下，滚到你脚边。墨迹隔着纸背透出来，张牙舞爪的笔画像是写的时候笔跟纸有仇。李白的脚在墙头晃荡，等着你开口。"
