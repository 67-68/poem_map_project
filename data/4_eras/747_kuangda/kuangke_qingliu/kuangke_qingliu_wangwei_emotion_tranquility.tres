[sub_resource type="Resource" id="Resource_4hjxe"]
script = ExtResource("6_4hjxe")
trait_name = "kuangda_kuangke"
failed_hint = "笔递到眼前时,他愣住了——他不敢接.这支笔重得像三十年的仕途,他怕落下去的不是远山."

[sub_resource type="Resource" id="Resource_mbcs3"]
script = ExtResource("7_mbcs3")
choice_result = SubResource("Resource_gd3xi")
requirement = SubResource("Resource_4hjxe")
description = "接过笔，在留白处点一痕远山，把笔搁回砚台。"

