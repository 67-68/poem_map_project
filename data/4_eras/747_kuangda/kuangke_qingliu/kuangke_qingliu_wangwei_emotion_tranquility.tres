[resource]
script = ExtResource("11_vqter")
requirement = SubResource("Resource_vqter")
era = "747_kuangda"
_target_tags = Array[String](["kuangke_qingliu"])
options = Array[ExtResource("1_21y1n")]([SubResource("Resource_mbcs3")])
uuid = "kuangke_qingliu_wangwei_emotion_tranquility"
name = "留白处"
description = "山中秋意已深，凉亭石桌上摊着王维未竟的雪景图。他用笔尖点点画面上方那片空着的地方，问你留白是否足够大。话音刚落，他把笔递过来，动作轻缓自然，像是你从未放下过这支笔。"
