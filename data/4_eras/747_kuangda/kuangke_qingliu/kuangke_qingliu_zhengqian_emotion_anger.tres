[sub_resource type="Resource" id="Resource_oxorn"]
script = ExtResource("6_oxorn")
trait_name = "kuangda_kuangke"
failed_hint = "他看着郑虔脖子上的青筋,想接过话头一起骂,但最终只是站在那里,什么也没说——明天郑虔的薪俸还会不够买葱,而他知道自己帮不上忙."

[sub_resource type="Resource" id="Resource_1wgnx"]
script = ExtResource("7_1wgnx")
choice_result = SubResource("Resource_xowst")
requirement = SubResource("Resource_oxorn")
description = "「三根葱你也配提？」你把刚买的酒往郑虔手里一塞，「走，乱葬岗骂去。」"

