_target_tags = Array[String](["actor:npc:shenyi", "social:upgrade"])
options = Array[ExtResource("1_opt")]([SubResource("Resource_opt1")])
uuid = "baiye_shenyi_upgrade"
name = "西市医庐"
description = "你在西市巷陌间辗转打听，终于寻到了那间不起眼的医庐。门帘半卷，药香扑鼻。神医正在院里翻晒药材，见你来访也不惊讶，只指了指檐下的竹凳让你坐。你递上名帖，他放下手中的药杵，用粗布擦了擦手，接过去看了看。「你就是他们说的那个杜甫？」他笑着斟了一碗药茶推过来，「我听过你的诗。坐，不急。」"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
