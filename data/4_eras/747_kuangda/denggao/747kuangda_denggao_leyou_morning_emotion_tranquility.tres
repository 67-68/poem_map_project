[resource]
script = ExtResource("12_kpxiv")
requirement = SubResource("Resource_inilg")
era = "747_kuangda"
_target_tags = Array[String](["ENV_POLITICS_PROSPER:cloud_and_sun", "ENV_NATURE_SNOWSTORM:lone_snow", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_leyou_morning", "emotion_pair:pair_tranquility", "VIBE_PHILOSOPHY_ZEN:temple_bell", "ENV_NATURE_SNOWSTORM:lone_snow"])
options = Array[ExtResource("1_25ufy")]([SubResource("Resource_y6uwq"), SubResource("Resource_yieeh"), SubResource("Resource_qe0le")])
uuid = "747kuangda_denggao_leyou_morning_emotion_tranquility"
name = "晨雾阑干"
description = "乐游原上薄雾如纱，长安城的轮廓在晨光中渐渐清晰。你倚着木栏，指尖在粗糙的木质上缓缓摩挲，望着远处终南山的黛青色山脊——雾气从山腰流过，像是水墨画里的留白。早市的叫卖声和炊烟一起升上来，模糊而遥远。你站在那里，风穿过衣襟，衣角轻轻拍着膝侧。身后有脚步声——一个人登上原头，在你左手边停下，也看着同一个方向。他没有说话，你也没有动。过了很久，那个人咳嗽一声，转身下山。脚步声越来越远，终南山的雾气又合拢了。"
