[resource]
script = ExtResource("12_d4jrb")
requirement = SubResource("Resource_qmdf5")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_pagoda_morning"])
options = Array[ExtResource("1_7dwsi")]([SubResource("Resource_ay4fo"), SubResource("Resource_141we"), SubResource("Resource_i5302")])
uuid = "747kuangda_denggao_pagoda_morning_emotion_tranquility"
name = "塔顶孤影瞰晨钟"
description = "卯时三刻，慈恩寺钟声荡开薄雾。你立在塔上第七层，手扶暗红色木栏。脚下的塔基广场上，人影渐密——青衫进士三五成群，有人展开一卷纸高声吟哦，佩玉相击声清脆。更远处，一乘朱轮车停在门外，帘子掀起半角。风从檐角穿过，吹动你袍角。你手指有一下没一下地叩着栏木，目光越过那些锦袍，落在更远处的终南山轮廓上。"
