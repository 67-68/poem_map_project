[resource]
script = ExtResource("12_0kjce")
requirement = SubResource("Resource_irs5a")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["TARGET_NPC_DUFU:thatched_grass", "ENV_SOCIETY_FAMINE:starving_bone", "VIBE_THEME_HISTORY:ruined_wall", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_shaoling_morning", "emotion_pair:pair_anger", "TARGET_FACTION_MILITARY:torn_flag", "ENV_SOCIETY_WAR:blood_stain"])
options = Array[ExtResource("1_yqn6x")]([SubResource("Resource_iou1s"), SubResource("Resource_jxevs"), SubResource("Resource_sibw7")])
uuid = "747kuangda_denggao_shaoling_morning_emotion_anger"
name = "野风卷怒"
description = "少陵原的晨风裹着土腥味扑面而来。远处长安城的炊烟在晨光中稀疏地升起——东边是曲江池畔的朱门烟囱，西边是贫民窟的冷灶。你站在原上，看着风把老农翻出的干土吹散，又看着远方那些豪宅在晨曦中熠熠生辉。脚跟下的土路干裂，每一步都带起一片扬尘。"
