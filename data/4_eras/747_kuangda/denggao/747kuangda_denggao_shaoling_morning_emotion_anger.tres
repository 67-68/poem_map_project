[resource]
script = ExtResource("12_0kjce")
requirement = SubResource("Resource_nrrbr")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_shaoling_morning"])
options = Array[ExtResource("1_yqn6x")]([SubResource("Resource_e76k2"), SubResource("Resource_0uvec"), SubResource("Resource_lc5ie")])
uuid = "747kuangda_denggao_shaoling_morning_emotion_anger"
name = "野风卷怒"
description = "少陵原的晨风裹着土腥味扑面而来。远处长安城的炊烟在晨光中稀疏地升起——东边是曲江池畔的朱门烟囱，西边是贫民窟的冷灶。你站在原上，看着风把老农翻出的干土吹散，又看着远方那些豪宅在晨曦中熠熠生辉。脚跟下的土路干裂，每一步都带起一片扬尘。"
