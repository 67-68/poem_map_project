[resource]
script = ExtResource("11_gimka")
requirement = SubResource("Resource_qxbfb")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["VIBE_THEME_MACABRE:ghost_fire", "ENV_NATURE_NIGHTMOON:cold_moon", "ENV_NATURE_AUTUMNWIND:falling_leaf", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_shaoling_night", "emotion_pair:pair_anger", "TARGET_FACTION_MILITARY:torn_flag", "ENV_SOCIETY_WAR:blood_stain"])
