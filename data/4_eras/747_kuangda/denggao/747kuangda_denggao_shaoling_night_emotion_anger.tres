[resource]
script = ExtResource("12_1etdw")
requirement = SubResource("Resource_o3whh")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_shaoling_night"])
options = Array[ExtResource("1_0wbv0")]([SubResource("Resource_7q73p"), SubResource("Resource_s5ygv"), SubResource("Resource_03u3f")])
uuid = "747kuangda_denggao_shaoling_night_emotion_anger"
name = "鬼火照见南北城"
description = "少陵原的夜像一口倒扣的锅。你摸黑爬到高处，脚下碎石滚落，惊起宿鸟。远处古墓间幽绿鬼火明灭，像是地底的眼睛。你站定回望，长安城在夜色中分成明暗两半——南边灯火连成一片，北边黑得像被墨泼过。风穿过枯枝，呜呜作响，像有人在哭。你攥紧手，指节叩进掌心。"
