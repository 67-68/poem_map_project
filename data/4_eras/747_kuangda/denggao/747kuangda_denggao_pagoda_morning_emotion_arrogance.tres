[resource]
script = ExtResource("12_aom25")
requirement = SubResource("Resource_vw7g5")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_pagoda_morning"])
options = Array[ExtResource("1_wxyul")]([SubResource("Resource_8qlx1"), SubResource("Resource_4cpd8"), SubResource("Resource_f65el")])
uuid = "747kuangda_denggao_pagoda_morning_emotion_arrogance"
name = "塔顶振衣嗤名利"
description = "晨钟撞碎塔下湿雾。你登至第七层时，两腋生风。拂晓的长安城在脚下摊开如棋盘——坊市方正，街巷纵横，那些朱门与锦袍都缩成模糊的色块。塔下传来新科进士们高谈阔论的回声，被风撕成断断续续的碎片。你伸手掸了掸袖口沾着的塔灰，有几粒尘埃飘落下去，融进下界的晨光里。"
