[resource]
script = ExtResource("12_nh0qr")
requirement = SubResource("Resource_7epoo")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_pagoda_night"])
options = Array[ExtResource("1_0j0s1")]([SubResource("Resource_jm4xj"), SubResource("Resource_wgfx5"), SubResource("Resource_5ayvh")])
uuid = "747kuangda_denggao_pagoda_night_emotion_tranquility"
name = "月下碑影"
description = "月光被大雁塔的塔身切成两半，一半落在地面裂缝上，一半留在砖缝里的苔痕。你站在塔基边，借着微光辨认石碑上模糊的刻名——手指刚触到某一行的凹陷，头顶传来翅膀扑棱的声响。你抬头，塔铃在晃，月光里没有鸟的影子。低下头时，碑面上的月光又移动了半寸。远处墙角的阴影中有什么东西闪了一下，再看时已经暗了。"
