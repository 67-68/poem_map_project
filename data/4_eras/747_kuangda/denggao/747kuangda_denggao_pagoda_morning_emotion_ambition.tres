[resource]
script = ExtResource("11_uof3p")
requirement = SubResource("Resource_gbs83")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:temple_bell", "TARGET_FACTION_ROYAL:jade_step", "TARGET_MYTH_GIANTROC:giant_roc", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_pagoda_morning", "emotion_pair:pair_ambition", "TARGET_FACTION_ROYAL:jade_step", "TARGET_MYTH_GIANTROC:giant_roc"])
options = Array[ExtResource("1_60fb0")]([SubResource("Resource_c0551"), SubResource("Resource_3jsrx"), SubResource("Resource_p4axr")])
uuid = "747kuangda_denggao_pagoda_morning_emotion_ambition"
name = "塔砖裂纹与青苔"
description = "卯时，慈恩寺钟声震荡塔檐。塔基石板湿滑，晨露反光。塔下广场上，新科进士们倚栏吟诗，佩玉相碰，有人高声念诵新题。杜甫立在塔阶旁，右手扶住第一块塔砖，指腹沿着砖面一道裂纹从左划到右。视线越过人群，锁定远处朱门与衙署的轮廓。阶上青苔在晨光中泛着暗绿。钟声歇时，他换了一只脚承重，手指仍停在裂纹尽头。"
