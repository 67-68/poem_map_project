[resource]
script = ExtResource("11_6ksp5")
requirement = SubResource("Resource_cyccr")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["ENV_NATURE_NIGHTMOON:cold_moon", "ENV_NATURE_AUTUMNWIND:falling_leaf", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_leyou_night", "emotion_pair:pair_sorrow", "VIBE_THEME_HISTORY:ruined_wall", "ENV_NATURE_AUTUMNWIND:falling_leaf"])
