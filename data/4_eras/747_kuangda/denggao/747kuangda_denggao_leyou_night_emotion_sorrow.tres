era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_leyou_night"])
options = Array[ExtResource("1_dlxmu")]([SubResource("Resource_6ksp5"), SubResource("Resource_80ra3"), SubResource("Resource_8ldfr")])
uuid = "747kuangda_denggao_leyou_night_emotion_sorrow"
name = "灯火如星照孤影"
description = "乐游原上，晚风萧瑟。你立于原畔，望着脚下长安城万千灯火如繁星落地。远处传来模糊的人声与笛音，夜风将它们揉碎，送到你耳中时已辨不清悲喜。你站了很久，衣袍被风灌满，身体却越来越重。不是累了，是沉了。转身下山时，有露水般凉的东西落在你手背上。"
