[resource]
script = ExtResource("12_l5n0k")
requirement = SubResource("Resource_45o3i")
era = "747_kuangda"
_target_tags = Array[String](["ENV_POLITICS_PROSPER:cloud_and_sun", "ENV_NATURE_SNOWSTORM:lone_snow", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_leyou_morning", "emotion_pair:pair_numbness", "VIBE_PHILOSOPHY_ZEN:incense_ash", "TARGET_NPC_DUFU:thatched_grass"])
options = Array[ExtResource("1_3p4rm")]([SubResource("Resource_jdi0u"), SubResource("Resource_ins2j"), SubResource("Resource_otuvy")])
uuid = "747kuangda_denggao_leyou_morning_emotion_numbness"
name = "雾重肩沉"
description = "秋日清晨，你沿着湿滑的石阶登上乐游原。晨雾比前几日更浓，长安城的轮廓浮在雾中，像一幅未干透的水墨画。你靠在一棵老槐树粗糙的树干上时，膝盖咯吱响了一声。远处终南山的影子在雾里时隐时现，早市的叫卖声和人语碎片断断续续随风送上来。有人登原，在你身后几步停住——拂了拂石凳上的露水，坐了下来，没说话，也没起身离开。你垂下眼，看见自己袖口的泥渍和鞋帮上干涸的草屑。"
