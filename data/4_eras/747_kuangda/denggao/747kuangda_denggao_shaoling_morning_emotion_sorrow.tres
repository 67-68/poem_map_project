[resource]
script = ExtResource("12_adxgf")
requirement = SubResource("Resource_otdfu")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_shaoling_morning"])
options = Array[ExtResource("1_qhivb")]([SubResource("Resource_b5ojc"), SubResource("Resource_k5v11"), SubResource("Resource_dj1rj")])
uuid = "747kuangda_denggao_shaoling_morning_emotion_sorrow"
name = "疾风卷尘登高台"
description = "少陵原上，晨风裹着雨腥扑面，衣袍灌满冷气。远处长安城楼隐在昏光里，万家屋顶无声。脚下干裂的土纹被风抹平，几只鸟低叫掠过。站得久了，眼睛盯着城里某处烟柱，肩头落下凉凉一滴。抬头看天，云已压得很低。转身时风推着背，脚步慢慢挪向坡下。"
