[resource]
script = ExtResource("12_8h2jl")
requirement = SubResource("Resource_3nif8")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_leyou_morning"])
options = Array[ExtResource("1_et62m")]([SubResource("Resource_sm3jb"), SubResource("Resource_spnv0"), SubResource("Resource_feenq")])
uuid = "747kuangda_denggao_leyou_morning_emotion_arrogance"
name = "晨雾金瓦"
description = "天光未亮透，你已登乐游原东侧土坡。晨雾如纱，长安城九横九纵的坊墙从雾气中缓慢浮现，屋瓦镀上第一缕金，终南山在天边仅是一道青灰色的虚影。身后草叶沙沙响，有人踩着露水上来了，脚步声在你身后三步处停住。他没有开口，你能感到那道目光落在你的后背上。风里有早市胡饼的焦香，还有铜驼街方向传过来的隐约叫卖声。你站着，目光越过脚下的屋脊，一直看到终南山隐没在雾里。"
