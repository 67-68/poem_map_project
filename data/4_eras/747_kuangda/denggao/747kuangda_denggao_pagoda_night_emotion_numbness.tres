[resource]
script = ExtResource("11_muuhb")
requirement = SubResource("Resource_ltrfx")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["ENV_NATURE_NIGHTMOON:cold_moon", "VIBE_THEME_HISTORY:ruined_wall", "VIBE_PHILOSOPHY_ZEN:incense_ash", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_pagoda_night", "emotion_pair:pair_numbness", "VIBE_PHILOSOPHY_ZEN:incense_ash", "TARGET_NPC_DUFU:thatched_grass"])
options = Array[ExtResource("1_8dhxb")]([SubResource("Resource_w51k7"), SubResource("Resource_r5ds4"), SubResource("Resource_6nw51")])
uuid = "747kuangda_denggao_pagoda_night_emotion_numbness"
name = "碑前枯坐，月落风停"
description = "你沿着塔基走到北侧，在无名碑前停下。腿沉得抬不动，索性靠着石碑坐下，膝盖咯吱一声。月光被塔身切去一半，碑文的上半截泛着白，下半截埋在阴影里。你盯着几行字看了一会儿——那些名字入眼，但没入脑，像水从石面滑过。风从塔檐穿过来，铜铃响了两三声，又安静了。远处有更夫梆子响，一声长一声短，接着是几声狗叫。你坐着，脚底能感到底下砖缝的凉。坐了约莫一盏茶的时间，起了身，腿麻得厉害，扶了一把石碑才站稳。影子在地上从歪的拉成正的。你没再看碑文，顺着来路往回走。"
