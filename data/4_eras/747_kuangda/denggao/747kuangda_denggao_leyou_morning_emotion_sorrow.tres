[resource]
script = ExtResource("11_uchf3")
requirement = SubResource("Resource_m3f46")
era = "747_kuangda"
archetype_id = "denggao"
_target_tags = Array[String](["ENV_POLITICS_PROSPER:cloud_and_sun", "ENV_NATURE_SNOWSTORM:lone_snow", "ACTION_TRAVEL_CLIMB:high_tower", "action:scene_denggao_leyou_morning", "emotion_pair:pair_sorrow", "VIBE_THEME_HISTORY:ruined_wall", "ENV_NATURE_AUTUMNWIND:falling_leaf"])
options = Array[ExtResource("1_wunxo")]([SubResource("Resource_cxfjh"), SubResource("Resource_sl0jy"), SubResource("Resource_51b2h")])
uuid = "747kuangda_denggao_leyou_morning_emotion_sorrow"
name = "雾锁孤影"
description = "晨雾如愁，长安城在脚下摊开，屋瓦镀金，终南山隐现。有人登原，脚步声擦过你身侧，停在不远处的石栏旁。他低低说了句什么，像是自言自语，又像是对你说——风把字句吹散，只剩尾音挂在雾里。你没转头。远处早市的叫卖声断断续续，万家灯火灼眼，每一扇窗都亮得与你无关。那人站了片刻，又踏着雾气下山去了。衣角被风吹起，你抬手拢了拢，指节碰触到潮冷的石栏。"
