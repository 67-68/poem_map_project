[resource]
script = ExtResource("12_v8q66")
requirement = SubResource("Resource_1tjfq")
era = "747_kuangda"
_target_tags = Array[String](["action:scene_denggao_pagoda_night"])
options = Array[ExtResource("1_8ckih")]([SubResource("Resource_0cvxs"), SubResource("Resource_m2jff"), SubResource("Resource_n20di")])
uuid = "747kuangda_denggao_pagoda_night_emotion_fatigue"
name = "碑前枯坐，月落风停"
description = "你沿着塔基走到北侧，在无名碑前停下。腿沉得抬不动，索性靠着石碑坐下，膝盖咯吱一声。月光被塔身切去一半，碑文的上半截泛着白，下半截埋在阴影里。你盯着几行字看了一会儿——那些名字入眼，但没入脑，像水从石面滑过。风从塔檐穿过来，铜铃响了两三声，又安静了。远处有更夫梆子响，一声长一声短，接着是几声狗叫。你坐着，脚底能感到底下砖缝的凉。坐了约莫一盏茶的时间，起了身，腿麻得厉害，扶了一把石碑才站稳。影子在地上从歪的拉成正的。你没再看碑文，顺着来路往回走。"
