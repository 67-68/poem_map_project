[resource]
script = ExtResource("11_bp5mc")
requirement = SubResource("Resource_w6v4j")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:temple_bell", "ENV_NATURE_NIGHTMOON:cold_moon", "action:main:duzhuo", "TARGET_IDENTITY_QUANGUI"])
options = Array[ExtResource("1_rn4bw")]([SubResource("Resource_fdi6j"), SubResource("Resource_xpagl"), SubResource("Resource_3hws6")])
uuid = "zhuoliu_lieqi_hijacked_grief_identity_quangui"
name = "纸灰未冷"
description = "纸灰飞进眼睛时门被推开了。不是风吹的。那人停在门槛外，停了好一会儿——你跪在蒲团上，他站在门槛外，中间隔着昨夜烧尽的纸灰和今日尚未烧的纸钱。他不进来。庙里的寒气从地面往上漫，他站在门外仅一步远的地方，靴跟在石阶上轻轻磕了两下。“杜先生，就一句——今日午时，一首贺诗，老地方，要喜庆。”他没进来，只把话搁在门槛外，踩着你昨夜烧的纸灰转身走了。你回头时只看见他背影。靴跟上沾着黑色残烬。庙外他的马打了个响鼻，声音在空荡荡的大殿里弹了三个来回才落定。"
