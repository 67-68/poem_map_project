[resource]
script = ExtResource("7_e7p76")
era = "747_kuangda"
_target_tags = Array[String](["action:humiliation_aesthetic_violation", "action:scene_duzhuo"])
options = Array[ExtResource("1_sct02")]([SubResource("Resource_egvki"), SubResource("Resource_tbo2x"), SubResource("Resource_s3t6v")])
uuid = "duotai_humiliation_aesthetic_violation_gateway_duzhuo"
name = "酒肆改诗"
description = "“兄台方才那句‘江流石不转’固然好，只是太过沉郁。如今圣天子在上，四海升平——不如改作‘江流映日红’，既合时宜，又见气象。”他将自己的酒盏往你这边推了推，眼神诚恳，仿佛真是在帮你指一条明路。"
