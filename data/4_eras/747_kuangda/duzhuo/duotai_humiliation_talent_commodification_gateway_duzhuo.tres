[resource]
script = ExtResource("7_60taa")
era = "747_kuangda"
_target_tags = Array[String](["action:humiliation_talent_commodification", "action:scene_duzhuo"])
options = Array[ExtResource("1_et2im")]([SubResource("Resource_c1f6f"), SubResource("Resource_6fq7b"), SubResource("Resource_nniqe")])
uuid = "duotai_humiliation_talent_commodification_gateway_duzhuo"
name = "邻商索诗为礼"
description = "“听说你是诗人？我正要去户部王郎中府上拜谒，他好风雅。你替我写一首夸他清正的，这桌酒钱我结，再送你一包西域香料。”说话间将荷包往桌上一搁，眼神落向窗外，不看来人。"
