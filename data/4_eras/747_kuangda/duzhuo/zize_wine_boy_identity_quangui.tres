options = Array[ExtResource("1_cnlmm")]([SubResource("Resource_5x30j")])
uuid = "zize_wine_boy_identity_quangui"
name = "地上的湿痕"
description = "权贵走后半炷香，才有人把酒保往后厨拖。他的靴底在砖缝上划了一下，留下一道深色的痕迹。你看见桌上的碎银子——指甲盖大小，沾着一点血沫。你的手在袖子里张开，拇指碰到两枚铜钱。铜钱是凉的。手慢慢卷回去。旁边有人踢了一脚倒掉的酒坛，酒液还在往砖缝里渗。你站起身，绕过那片湿痕，从另一个方向走了。"
