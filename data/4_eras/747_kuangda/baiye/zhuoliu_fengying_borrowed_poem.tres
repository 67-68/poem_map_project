era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:ink_stone", "ENV_POLITICS_PROSPER:cloud_and_sun", "action:main:baiye"])
options = Array[ExtResource("1_idgx3")]([SubResource("Resource_pdwuh"), SubResource("Resource_jegde"), SubResource("Resource_0t627")])
uuid = "zhuoliu_fengying_borrowed_poem"
name = "灯焰数到第四遍"
description = "原来如此。你的酒杯空了有一阵了，没人斟。你发现自己已经在心里数第四遍他桌边那只铜灯的灯焰跳了几次。第三遍时你觉得该停了。第四遍还在数。"
