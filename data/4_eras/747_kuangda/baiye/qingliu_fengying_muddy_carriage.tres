[resource]
script = ExtResource("13_rg2ka")
requirement = SubResource("Resource_i2otb")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_fengying", "action:main:baiye"])
options = Array[ExtResource("1_2m5h5")]([SubResource("Resource_h5kdk"), SubResource("Resource_j8ye3"), SubResource("Resource_3u4xe")])
uuid = "qingliu_fengying_muddy_carriage"
name = "靴与泥"
description = "李相车架前的石板路上积雪未消，马蹄在辔头下焦躁刨地——那匹青骢马认得你。七日来你每日此时站在府门外，门子今晨对你点了点头，像对打更的老刘头打招呼。靴子飞出去的弧线在三丈外划进臭水沟，溅起的泥点落在你袍角。你蹲过七天的墙角正好对着那滩泥。周围官员的目光移过来——不是看诗人，是看熟面孔该有的眼色。"
