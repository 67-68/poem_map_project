[resource]
script = ExtResource("12_nycap")
requirement = SubResource("Resource_n8hfa")
era = "747_kuangda"
_target_tags = Array[String](["TARGET_FACTION_ROYAL:jade_step", "ENV_NATURE_NIGHTMOON:cold_moon", "action:main:baiye"])
options = Array[ExtResource("1_7usxe")]([SubResource("Resource_j8ye3"), SubResource("Resource_eo50i"), SubResource("Resource_wwjk3")])
uuid = "qingliu_fengying_muddy_carriage"
name = "鞋入臭水"
description = "腊月里的泥泞又黑又稠，像煮过头的药渣。李相的车驾刚拐过街角，惊马前蹄一扬，那只锦缎绣鞋从轿帘里飞出来，划过一道弧，正落进路边尺许深的臭水沟。门子认得你——他冲你点了点头，像对隔三差五来串门的街坊。周围官员的目光齐刷刷落在你身上，不是看你这个诗人，是看这个“老熟人”。"
