[resource]
script = ExtResource("12_uf2qr")
requirement = SubResource("Resource_mro0x")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:temple_bell", "TARGET_NPC_DUFU:thatched_grass", "action:main:baiye"])
options = Array[ExtResource("1_d3vfl")]([SubResource("Resource_7wbnp"), SubResource("Resource_6hqed"), SubResource("Resource_u35dr")])
uuid = "zhuoliu_fengying_reluctant_mentor"
name = "推门，他熟门熟路"
description = "李十二郎推开你那间租来的破屋门时没敲门。他身后站着一个年轻人——二十出头，诗稿捏在手里，指节发白。李十二郎搭着你肩拍了两下，那力度和三个月前你替他誊抄账本时一模一样。“这孩子想投卷，你领他走一趟韦府。”年轻人膝盖微屈，将跪未跪。你看见诗稿最上面那首，题目是你二十三岁时也写过的题材。"
