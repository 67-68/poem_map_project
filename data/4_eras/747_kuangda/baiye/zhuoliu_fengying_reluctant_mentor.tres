[resource]
script = ExtResource("13_ty1k8")
requirement = SubResource("Resource_w47j5")
era = "747_kuangda"
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_71vnk")]([SubResource("Resource_n2n2t"), SubResource("Resource_1bch0"), SubResource("Resource_wyatn")])
uuid = "zhuoliu_fengying_reluctant_mentor"
name = "推门，他熟门熟路"
description = "李十二郎推开你那间租来的破屋门时没敲门。他身后站着一个年轻人——二十出头，诗稿捏在手里，指节发白。李十二郎搭着你肩拍了两下，那力度和三个月前你替他誊抄账本时一模一样。“这孩子想投卷，你领他走一趟韦府。”年轻人膝盖微屈，将跪未跪。你看见诗稿最上面那首，题目是你二十三岁时也写过的题材。"
