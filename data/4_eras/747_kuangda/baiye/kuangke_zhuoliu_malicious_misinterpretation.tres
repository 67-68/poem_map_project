options = Array[ExtResource("1_50i87")]([SubResource("Resource_qc62b"), SubResource("Resource_0ls3e"), SubResource("Resource_np2lp")])
uuid = "kuangke_zhuoliu_malicious_misinterpretation"
name = "浊流设宴，诗成铁证"
description = "“野老墙低还似旧。”他停下来，看着你对旁边的人笑了一声：“这墙低，说的是谁家的墙？”旁边的人没答话。他把竹筒搁回案上，手指在“墙低”二字上敲了三下。站在你身后的随从把门帘放了下来。"
