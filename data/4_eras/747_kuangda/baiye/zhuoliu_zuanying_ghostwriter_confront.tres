[resource]
script = ExtResource("9_lkc51")
requirement = SubResource("Resource_jrmgq")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:giant_roc", "TARGET_NPC_DUFU:jade_step", "action:main:baiye"])
options = Array[ExtResource("1_lyhaa")]([SubResource("Resource_nlvcd"), SubResource("Resource_oiut7"), SubResource("Resource_i5hcb")])
uuid = "zhuoliu_zuanying_ghostwriter_confront"
name = "代笔旧账"
description = "贡院东墙外的小酒馆，灯笼在秋风中晃。几个举子的议论声从角落飘来——「那首《登科后》真是意气风发」「听说是张侍郎公子的手笔」。你认得那首诗。三个月前在张府后院，你用了两壶酒的时间把那些句子排好，换来一纸谒帖的承诺。现在张公子端着酒杯走过来了，靴底踩在松木地板上，每一步都稳得很。「子美兄，我爹很满意上回那首。这次再来一首？」酒杯往你这边推了半寸，杯沿上的唇印还没干透。他的语气像在谈一笔已经成交的买卖。"
