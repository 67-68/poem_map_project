[resource]
script = ExtResource("11_tvqgt")
requirement = SubResource("Resource_468jq")
era = "747_kuangda"
archetype_id = "baiye"
_target_tags = Array[String](["TARGET_OBJECT_SWORD:cold_blade", "VIBE_THEME_MARTIAL:giant_roc", "action:main:baiye", "TARGET_IDENTITY_ZHUOLIU_OFFICIAL"])
options = Array[ExtResource("1_ev2yd")]([SubResource("Resource_klxxx"), SubResource("Resource_vr8dt"), SubResource("Resource_42rft")])
uuid = "zhuoliu_lieqi_ghostwriter_blood_identity_zhuoliu_official"
name = "碑记与刀环"
description = "坊墙下的风是从北边灌进来的。年老的那个挡在你面前，离你三步，刚好占住你唯一能起身的方向。年轻的站在你身后，你听见他的手指一下一下拨着刀环，铁碰铁，不高不低，像在敲一种不需要旋律的拍子。年老的那个没有催，他把那个名字又说了一遍，放慢了说，像在教一个孩童认字。然后他从袖中取出一卷纸，展开——是空白的，只在上方端正地压了一方朱砂印。他将纸放在你膝边的冻土上，压了一小块碎银在纸角。风把纸边掀起一点，又落下。"
