[resource]
script = ExtResource("13_k4cyf")
requirement = SubResource("Resource_cvuji")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_fengying", "action:main:baiye"])
options = Array[ExtResource("1_dduhv")]([SubResource("Resource_55a8l"), SubResource("Resource_moajf"), SubResource("Resource_aedch")])
uuid = "qingliu_fengying_aesthetic_rape"
name = "朱批旧稿"
description = "考官将你的诗稿推回桌案，朱笔圈住的正是全诗最得意的那一联。他没有解释为何要改，只是看向一旁负责誊抄的笔吏。你认得此人——上次干谒时，也是他在旁边记录。那时你曾主动为他润色过两首应酬诗。现在他望过来，嘴角没有笑意，眼神里是种平淡的了然。考官敲了敲砚台，笔吏已将墨研好，等你拿起笔来。窗外有雀鸟扑棱飞过，屋子里很静。"
