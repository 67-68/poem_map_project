[resource]
script = ExtResource("13_k4cyf")
requirement = SubResource("Resource_tmsva")
era = "747_kuangda"
_target_tags = Array[String](["action:main:baiye"])
options = Array[ExtResource("1_dduhv")]([SubResource("Resource_h7kn1"), SubResource("Resource_gtrgd"), SubResource("Resource_tbqku")])
uuid = "qingliu_fengying_aesthetic_rape"
name = "朱笔圈诗眼"
description = "考官把你的诗稿推回来，朱笔在颈联上圈了一笔。圈得圆熟利落，像做过很多次。旁边那位笔吏正在抄录，抄的还是你上次递来的干谒诗——他在旁边记了三年。他抬头看你一眼，眼神里没有鄙夷，只有了然。笔尖悬在纸上，等你说改。上次你就改了。"
