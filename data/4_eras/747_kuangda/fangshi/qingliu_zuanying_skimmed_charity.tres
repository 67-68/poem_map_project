[sub_resource type="Resource" id="Resource_7m081"]
script = ExtResource("7_01mkg")
choice_result = SubResource("Resource_52jlt")
description = "将对账单推回半寸，指向“实收”那栏：“这一石六斗是米铺记错了——他们送到的是陈米，我退了差价。”"

[sub_resource type="Resource" id="Resource_2533j"]
script = ExtResource("9_678bs")
trait_name = "kuangda_zuanying"

[resource]
script = ExtResource("10_fusxl")
requirement = SubResource("Resource_2533j")
era = "747_kuangda"
_target_tags = Array[String](["ENV_NATURE_SNOWSTORM:cloud_and_sun", "VIBE_PHILOSOPHY_ZEN:medicine_stall", "action:main:fangshi"])
options = Array[ExtResource("1_73wo3")]([SubResource("Resource_u6avk"), SubResource("Resource_yyids"), SubResource("Resource_7m081")])
uuid = "qingliu_zuanying_skimmed_charity"
name = "对账单的收件人"
description = "赵崇嗣是申时才到的。他先看了檐下的燕子窝，又问了新砌的砖缝为何比旧砖浅了半寸。茶换了三盏，他才从袖中取出那张米铺对账单，放在桌上推过半寸，收件人写的是他的名字。他没用手指去点那个数字——只是把账单留在那里，起身看了看窗外粥棚的方向。“不急，”他说，“你慢慢算。”你注意到账单上“实收”一栏的数字，比你上次报给他的，差了一石六斗。米铺伙计认得你的脸——昨天他去粥棚送米时，你在场。"
