[resource]
script = ExtResource("10_fusxl")
requirement = SubResource("Resource_2533j")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_73wo3")]([SubResource("Resource_u6avk"), SubResource("Resource_yyids"), SubResource("Resource_7m081")])
uuid = "qingliu_zuanying_skimmed_charity"
name = "库房里的缺口"
description = "郑虔没有带账本。他站在你借来的库房中央，目光从堆叠的米袋上缓缓移过。靠墙那一垛是你从官仓借调充数的——封条是旧的，麻绳的系法不对。墙角有半张当票，贴着泥地，上面印着大兴县典当行的朱砂戳。郑虔蹲下来，用两根手指拈起那张纸片，对着光看了看，搁回原处。他没说话。米袋之间的缝隙里，空了大半的竹筐露出边角。那是你报账时写了“实收一百石”的那一批。"
