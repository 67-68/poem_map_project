[resource]
script = ExtResource("11_37gnr")
requirement = SubResource("Resource_3thi0")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:ink_stone", "TARGET_NPC_DUFU:thatched_grass", "action:main:fangshi", "TARGET_IDENTITY_MENZI"])
options = Array[ExtResource("1_1qtwi")]([SubResource("Resource_r0re8")])
uuid = "qingliu_jiaolv_status_tax"
name = "一件旧袍"
description = "张垍旧宅偏院的槐树下，小厮引你到一处厢房。床上摊开一件半旧圆领袍，袖口磨得发亮，料子在暗处隐隐泛着青灰——不是新物，是被人穿过的。那人靠在门框上，没开口谈价。他说，上次穿着这件衣裳的人现在在万年县做县尉。又说，集贤院散席的时候，魏某人在门口看见这领子——唤了一声张公。说完他从袖中抽出一封信，是你三年前写给张垍的自荐诗。信纸在浆洗过的衣领旁展开，墨迹已经有些洇开了。他把信放在袍子上，什么也没说。"
