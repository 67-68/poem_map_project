[resource]
script = ExtResource("11_risnn")
requirement = SubResource("Resource_risnn")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_i252f")]([SubResource("Resource_2r3vh")])
uuid = "kuangke_qingliu_gaoshi_emotion_anger"
name = "三碗酒后摔碗"
description = "下杜城西的小酒肆，高适灌下第三碗浊酒，碗底往桌上一顿，酒水溅出来洒了半张桌。「今日在朱雀街碰见兵部的书吏，」他声音压得极低，「他问我河西怎么走——他娘的兵部书吏，问一个幕府参谋河西怎么走。」说完笑得浑身发抖，笑容里有火。"
