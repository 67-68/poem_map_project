era = "747_kuangda"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:dry_lips", "TARGET_OBJECT_SWORD:medicine_stall", "action:main:fangshi"])
options = Array[ExtResource("1_3sveu")]([SubResource("Resource_5c4yr"), SubResource("Resource_f4lwr"), SubResource("Resource_ce5un")])
uuid = "qingliu_zuanying_pawned_artifact"
name = "锦匣已空"
description = "卯时三刻，李十二娘托人带了一封短札来——「过两日来取前次托你转呈崔侍御的信，顺道看看我那方端砚养得可好。」不是质问，不是索还。是清流式的「看一眼」。你书架上那只镂雕锦匣已经空了三个月——端砚早在腊月里进了西市当铺，换的银两填了你在平康坊欠下的酒债。锦匣还在，位置没变，只是匣内的砚台换成了一块形状相似的河石。"
