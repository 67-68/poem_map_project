[resource]
script = ExtResource("10_5c4yr")
requirement = SubResource("Resource_i8yi1")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_5a0bk")]([SubResource("Resource_0q0py"), SubResource("Resource_lyt52"), SubResource("Resource_6tsx6")])
uuid = "qingliu_zuanying_pawned_artifact"
name = "赎当呈堂与赝品抵值"
description = "“若还在用，不必多礼。”纸页在指间翻动时，簌簌作响的却不是纸——是息钱。那镇纸早已躺在西市抵了三月的炭资，如今连当票都转了两手。来人是清流圈里的老面孔，替收件人捎话。茶杯在桌上搁凉了，白釉边缘印着一圈干涸的茶渍，像画押。来人不催，只坐着。沉默也有息钱，比银子还贵。"
