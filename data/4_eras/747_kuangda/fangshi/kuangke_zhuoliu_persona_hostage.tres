[resource]
script = ExtResource("11_7k6vs")
requirement = SubResource("Resource_mli68")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_af1jb")]([SubResource("Resource_7k6vs"), SubResource("Resource_6i1x7"), SubResource("Resource_orweu")])
uuid = "kuangke_zhuoliu_persona_hostage"
name = "赏花帖"
description = "信在手上停了很久——不是内容多难读，而是信末那句附言印进指甲缝里。灰衣仆从站在三步外，不等回话，只是看。他的眼珠跟着你折信纸的指节从左移到右。巷口有马匹打喷嚏的声音。你把信叠回原样的时候，纸边割进食指第二个关节，没流血。"
