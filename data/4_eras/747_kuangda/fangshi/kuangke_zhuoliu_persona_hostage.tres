[resource]
script = ExtResource("10_qeviy")
requirement = SubResource("Resource_orweu")
era = "747_kuangda"
_target_tags = Array[String](["ENV_NATURE_NIGHTMOON:cold_moon", "action:main:fangshi"])
options = Array[ExtResource("1_cptih")]([SubResource("Resource_4q6fq"), SubResource("Resource_ft0ul"), SubResource("Resource_fok2k")])
uuid = "kuangke_zhuoliu_persona_hostage"
name = "赏花帖"
description = "信在手上停了很久——不是内容多难读，而是信末那句附言印进指甲缝里。灰衣仆从站在三步外，不等回话，只是看。他的眼珠跟着你折信纸的指节从左移到右。巷口有马匹打喷嚏的声音。你把信叠回原样的时候，纸边割进食指第二个关节，没流血。"
