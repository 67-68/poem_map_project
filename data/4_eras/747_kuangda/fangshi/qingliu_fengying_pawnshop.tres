[resource]
script = ExtResource("12_gnsff")
requirement = SubResource("Resource_g3m7c")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:ink_stone", "TARGET_OBJECT_SWORD:rusty_sword", "action:main:fangshi"])
options = Array[ExtResource("1_scee4")]([SubResource("Resource_junl5"), SubResource("Resource_ue6l3"), SubResource("Resource_dchn0")])
uuid = "qingliu_fengying_pawnshop"
name = "当铺题诗"
description = "西市当铺的柜台被无数人的手肘磨得油亮。掌柜从柜台后面抬起眼皮——他认得你。去年腊月你在这当了一件旧棉袍，开春又来当了一方洮砚。此刻你的字画卷轴尚未完全展开，他那根肥厚的手指已经压在画轴上，只露出半边题款。“你这幅画嘛——”他的目光从画上扫过，像在估一堆旧衣，“比上回那件袍子好点，但也好不到哪去。”他把价压到令人发指的低位，然后推过来一张糙纸和秃笔，“顺便题首诗夸夸我这当铺，我多给你二十文。”纸已经在桌案上铺好，笔尖已经干结。"
