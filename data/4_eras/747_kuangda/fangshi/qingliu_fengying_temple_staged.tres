[resource]
script = ExtResource("12_njl6c")
requirement = SubResource("Resource_24j8i")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:temple_bell", "ENV_NATURE_SNOWSTORM:lone_snow", "action:main:fangshi"])
options = Array[ExtResource("1_ee0y5")]([SubResource("Resource_yspwr"), SubResource("Resource_b8llb"), SubResource("Resource_fw3qo")])
uuid = "qingliu_fengying_temple_staged"
name = "慈恩寺雪中偶遇"
description = "“施主，上个月你也来过——那天是王给事中进香。今天亲王来，你又来了。”说完继续扫地。雪落在他刚扫过的青石上，又积了一层。殿门紧闭，里面传来亲王与方丈的谈笑，声音在雪里闷着，不太真切。"
