[resource]
script = ExtResource("13_38tk2")
requirement = SubResource("Resource_b1gpj")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_dmttr")]([SubResource("Resource_jokkf"), SubResource("Resource_3r77q"), SubResource("Resource_xcotv")])
uuid = "qingliu_fengying_temple_staged"
name = "慈恩寺雪中偶遇"
description = "“施主，上个月你也来过——那天是王给事中进香。今天亲王来，你又来了。”说完继续扫地。雪落在他刚扫过的青石上，又积了一层。殿门紧闭，里面传来亲王与方丈的谈笑，声音在雪里闷着，不太真切。"
