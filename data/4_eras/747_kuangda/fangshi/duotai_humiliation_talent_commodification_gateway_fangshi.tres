[resource]
script = ExtResource("7_ovbbt")
era = "747_kuangda"
_target_tags = Array[String](["action:humiliation_talent_commodification", "action:scene_fangshi"])
options = Array[ExtResource("1_8lumv")]([SubResource("Resource_8tggg"), SubResource("Resource_wkgp7"), SubResource("Resource_3jyno")])
uuid = "duotai_humiliation_talent_commodification_gateway_fangshi"
name = "纸铺前的交易"
description = "西市东街第三间纸铺，摊上堆着宣州楮纸和蜀郡麻纸。老板是个四十来岁的瘦削汉子，正用湿布擦柜台。见你路过，他抬头打量了你两眼，放下抹布，从架子上抽出一刀纸，搁在柜面上。“听说你会作诗？”他说得很随意，像在问菜价。“替我写一首夸我铺子的——笔在这，墨在这，写好了，这刀纸你拿去，不用给钱。”他说话时眼睛看着纸，没看你。"
