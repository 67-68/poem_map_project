era = "747_kuangda"
_target_tags = Array[String](["ENV_NATURE_SNOWSTORM:lone_snow", "TARGET_NPC_DUFU:thatched_grass", "action:main:fangshi"])
options = Array[ExtResource("1_ha0y5")]([SubResource("Resource_vmu6x"), SubResource("Resource_dxoju"), SubResource("Resource_rhq41")])
uuid = "zhuoliu_lieqi_poverty_tourism"
name = "赛博贫困游"
description = "“看见这洞了么？屋里比屋外还冷三分。”他没有进屋，只是隔着门帘吩咐：子美，出来走两步，让她们看看你是怎么过冬的。帘子那头没有回应。他笑了一声，不高不低：“不打紧，我等得起。”"
