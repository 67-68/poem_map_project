[resource]
script = ExtResource("11_g8kpo")
requirement = SubResource("Resource_ljde6")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_gm4co")]([SubResource("Resource_g8kpo"), SubResource("Resource_pei2u"), SubResource("Resource_nro1x")])
uuid = "kuangke_zhuoliu_toxic_patron"
name = "画为饵"
description = "“吴道子真迹。主上说，先生是长安城里少数不用钱能砸动的人。”他顿了顿，“所以不用钱——用画。先生点评两句，就带走。”茶盏在他右手边冒着热气，你的那盏搁在茶几左侧，隔着一张空椅子。"
