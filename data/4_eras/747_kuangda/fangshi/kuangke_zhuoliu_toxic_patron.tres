[resource]
script = ExtResource("10_2ppg2")
requirement = SubResource("Resource_nro1x")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_PHILOSOPHY_ZEN:temple_bell", "action:main:fangshi"])
options = Array[ExtResource("1_olxa1")]([SubResource("Resource_31d8i"), SubResource("Resource_chfmm"), SubResource("Resource_26wov")])
uuid = "kuangke_zhuoliu_toxic_patron"
name = "画为饵"
description = "“吴道子真迹。主上说，先生是长安城里少数不用钱能砸动的人。”他顿了顿，“所以不用钱——用画。先生点评两句，就带走。”茶盏在他右手边冒着热气，你的那盏搁在茶几左侧，隔着一张空椅子。"
