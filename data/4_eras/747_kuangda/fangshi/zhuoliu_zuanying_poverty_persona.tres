[resource]
script = ExtResource("10_663s0")
requirement = SubResource("Resource_a4ycq")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_csy2j")]([SubResource("Resource_nxft6"), SubResource("Resource_tv5md"), SubResource("Resource_st7nd")])
uuid = "zhuoliu_zuanying_poverty_persona"
name = "旧衣摊前的账本"
description = "城东的旧衣摊弥漫着霉味和旧尘。你把那件洗得发白的袍子展开——袖口磨出毛边，领子泛黄，正合你经营多年的贫寒模样。摊主老周堆着笑递过来，袖子里却抖出一张纸条。“杜先生，上月南城那封信替你换了五贯，这账我记得。今天这件袍子，就不跟你砍价了——你帮我个忙。”他把纸条往你掌心推了推，上面写着城南韦府一个通房丫头的名字。“你替我给这个人递句话，她的私盐生意我查清了。不递，我就跟左邻右舍讲讲你穿旧袍子替人写密信的事。”"
