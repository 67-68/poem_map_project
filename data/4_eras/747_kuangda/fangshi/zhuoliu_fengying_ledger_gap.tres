[resource]
script = ExtResource("13_llkma")
requirement = SubResource("Resource_tx00h")
era = "747_kuangda"
_target_tags = Array[String](["action:main:fangshi"])
options = Array[ExtResource("1_mr3en")]([SubResource("Resource_nxp1d"), SubResource("Resource_ob8ap"), SubResource("Resource_ebvbe")])
uuid = "zhuoliu_fengying_ledger_gap"
name = "第十三页的空白"
description = "屋里点着三盏灯，两盏在他和巡按那边，一盏在你这边。你的灯芯短了一截，读账本时要把纸凑到眼前。那些数字你已经抄了两个时辰，闭着眼也能接着写。账房李九推门进来，把一本摊开的账册放到你面前——第十三页有一条空行，进项数目写着八十三贯，来源栏却空着。他指着那行空白说，巡按大人在查这一笔，需要一个来源。他没说让你填，也没让你编，只是把那页纸往你面前推了推。上一次他这样推纸过来，是让你替他重抄了一份丢失的采办单——那是三年前的事了，他知道你不会拒绝。"
