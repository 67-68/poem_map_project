[resource]
script = ExtResource("13_llkma")
requirement = SubResource("Resource_3dntl")
era = "747_kuangda"
_target_tags = Array[String](["VIBE_AESTHETIC_ELEGANT:ink_stone", "TARGET_FACTION_ROYAL:jade_step", "action:main:fangshi"])
options = Array[ExtResource("1_mr3en")]([SubResource("Resource_an15d"), SubResource("Resource_pbkdv"), SubResource("Resource_qasou")])
uuid = "zhuoliu_fengying_ledger_gap"
name = "旧账上的墨点"
description = "巡按的笑声透过屏风传过来——他们在聊长安新到的阳羡茶，语气松散得像聊自家园子的杏花。张主簿推过一摞账册，翻到第四页，笔杆点了点那个数字。“跟第七页对不上吧。”他说这话时没看你，语气像在吩咐一个知道规矩的人。你知道他为什么这么跟你说话——上次帮他整理那些说不清来源的租契时，你问过一句“总数要不要盘”，他用同样的笔杆在同样的位置点了两下。那个墨点还在。"
