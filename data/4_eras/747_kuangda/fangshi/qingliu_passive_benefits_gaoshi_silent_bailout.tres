[resource]
script = ExtResource("12_nsp07")
requirement = SubResource("Resource_aes4r")
era = "747_kuangda"
_target_tags = Array[String](["qingliu_aid", "action:main:fangshi"])
options = Array[ExtResource("1_mjf5t")]([SubResource("Resource_qlfbs"), SubResource("Resource_10j6p"), SubResource("Resource_mjl4c")])
uuid = "qingliu_passive_benefits_gaoshi_silent_bailout"
name = "错买的冬衣"
description = "高适从河西回长安述职，路过下杜城时在街口截住你。他拎着一件羊皮袄子，说是给军中袍泽带的，结果尺码错了退不了——“你试试，穿不上我就扔了。”袄子大了一号，裹在你瘦削的身板上，正够塞进一件旧棉衣。他说完便走，头也不回。你站在巷口，手里攥着这张羊皮，风灌不进去了。"
