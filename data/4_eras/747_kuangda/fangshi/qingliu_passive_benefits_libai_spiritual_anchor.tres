options = Array[ExtResource("1_3onc2")]([SubResource("Resource_2rho5"), SubResource("Resource_j55sl"), SubResource("Resource_62kyl")])
uuid = "qingliu_passive_benefits_libai_spiritual_anchor"
name = "沙上剑书"
description = "天宝十三载秋，李白过下杜城。他醉了，没叩你的门。后来有人在渭水边的沙地上看见一行字——是用剑尖划出的“杜子美”三字，歪斜潦草，旁边散落着马蹄印，延伸向潼关方向。那人来告诉你时，沙上的字迹已被风吹浅了一半。"
