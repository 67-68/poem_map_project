[resource]
script = ExtResource("6_t2b8r")
options = Array[ExtResource("1_bo5t2")]([SubResource("Resource_opt")])
uuid = "tut_defer_done"
name = "云开雾散"
description = "两旬时光匆匆而过。这一日清晨，你来到道士打坐处，见他缓缓睁开眼睛。\n\n「成了。」道士拂尘一挥。\n\n你抬头望去，笼罩山顶的浓雾正以肉眼可见的速度消散。阳光穿透云层，将泰山之巅染成一片金黄。那巍峨的山体第一次完整地展现在你面前——这就是泰山，如画，如诗。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
