[resource]
script = ExtResource("6_t2b8r")
options = Array[ExtResource("1_br8w2")]([SubResource("Resource_opt")])
uuid = "tut_poem_review"
name = "道人评诗"
description = "几杯药酒下肚，文思果然如泉涌。你一气呵成写下一首诗，虽谈不上绝妙，却也有几分少年人的锐气。

道士不知何时已站在你身后，探头看了一眼诗稿，眼中闪过惊艳之色。

「好！好一句『会当凌绝顶，一览众山小』！」道士拍手称赞，「年轻人，你这诗才，他日必有大名。」"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
