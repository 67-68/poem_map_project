[resource]
script = ExtResource("5_m3k6j")
options = Array[ExtResource("1_fh9w2")]([SubResource("Resource_opt")])
uuid = "tut_dialogue_2"
name = "少年意气"
description = "道士闻言，微微颔首：「年纪轻轻便有此志，难得。」\n\n他抬头望向山间云雾，缓缓道：「这泰山虽不算天下最高，却也是个好起点。往东可望大海，往西便是中原。你若要游历，从此处出发倒也不差。」\n\n你顺着他的目光看去，山峦层叠，云海翻涌，心中不由得生出几分豪气。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
