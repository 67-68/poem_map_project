[resource]
script = ExtResource("5_t2b8r")
options = Array[ExtResource("1_bopt")]([SubResource("Resource_opt")])
uuid = "tut_lookup_mountain"
name = "一览众山"
description = "你登上泰山之巅，极目远眺。

脚下的云雾如海浪般翻涌，远处群山在云海中若隐若现，如同浮在白色汪洋中的青色岛屿。天穹如盖，星斗罗列其间，天地间仿佛只剩下你一人。

万里沧波翻涌，日月若出其中，星汉灿烂若出其里。

一页页竹简在眼前展开，上面写满了兴亡成败的名字。

你忽然明白——这壮丽山河，便是你要书写的诗行。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
