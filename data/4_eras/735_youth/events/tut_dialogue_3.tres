[resource]
script = ExtResource("5_t2b7r")
options = Array[ExtResource("1_cn9x2")]([SubResource("Resource_opt")])
uuid = "tut_dialogue_3"
name = "志在四方"
description = "道士将铜钱递还给你，正色道：「杜小友，贫道观你不是甘于庸碌之人。你这等读书人，心里都揣着一团火——那是志向，是抱负。」\n\n他抬手指向远方：「你且看这天地。有人为名利奔波，有人为家国忧心。读圣贤书，所为者何？」\n\n他顿了顿：「文思、声望、时运——这三样东西，日后会推着你往前走，也会在关键时刻绊你一脚。心中有数，方能行远。」"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
