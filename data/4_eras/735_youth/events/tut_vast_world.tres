[resource]
script = ExtResource("6_t2b8r")
options = Array[ExtResource("1_bf3q5")]([SubResource("Resource_opt")])
uuid = "tut_vast_world"
name = "天地苍茫"
description = "道士带你绕过几条山路，眼前豁然开朗——一整片开阔的山谷，远处群山如黛，云海翻涌。风声穿过松林，带着湿润的草木气息。

你站在崖边，看着脚下绵延至天际的山脉，胸中涌起一股说不清的情绪。天地如此之大，而你只是其中一粒尘埃。

道士在你身旁站定，轻声道：「贫道需打坐片刻，你自去转转吧。这山间还有不少可看之处。」

说罢，他寻了一块青石盘膝坐下，闭上双眼，不再言语。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
