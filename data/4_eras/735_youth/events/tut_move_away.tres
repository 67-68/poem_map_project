[resource]
script = ExtResource("6_t2b8r")
options = Array[ExtResource("1_bg3q2")]([SubResource("Resource_opt")])
uuid = "tut_move_away"
name = "山间迷雾"
description = "你沿着山路走到了泰山另一侧。抬头想看清山顶的轮廓，却发现一层浓雾将山头裹得严严实实，什么也看不见。

山风一起，雾气翻涌如浪，隐约间似乎能瞧见山巅的轮廓，又好像什么都没有。

你想起了道士——他在此山修行多年，或许知道这雾的来历。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
