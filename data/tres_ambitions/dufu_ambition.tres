stage_id = "stage0"
perception_text = "「状态」长安布衣。相府的门房连正眼都不会看你。长安城的名利场里，查无此人。"
metadata/_custom_type_script = "uid://bte53fleub1ki"

[sub_resource type="Resource" id="Resource_62cbg"]
script = ExtResource("6_ivce5")
stage_id = "stage1"
perception_text = "「状态」名动公卿。你的干谒诗已被多位权贵传阅。只要再多送些盘缠，补上几首好诗，似乎就只差那临门一脚了"
metadata/_custom_type_script = "uid://bte53fleub1ki"

[sub_resource type="Resource" id="Resource_fb1kn"]
script = ExtResource("6_ivce5")
stage_id = "stage2"
perception_text = "窃比稷契。相国已向你许下重诺。你自认才华已比肩上古贤相稷与契，立登要路津，就在今朝！"
metadata/_custom_type_script = "uid://bte53fleub1ki"

