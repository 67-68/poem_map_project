perception_text = "「状态」名动公卿。你的干谒诗已被多位权贵传阅。只要再多送些盘缠，补上几首好诗，似乎就只差那临门一脚了"
metadata/_custom_type_script = "uid://bte53fleub1ki"

[sub_resource type="Resource" id="Resource_fb1kn"]
script = ExtResource("6_ivce5")
