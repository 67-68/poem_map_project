[sub_resource type="Resource" id="Resource_poisoned_trait"]
script = ExtResource("3_traitop")
_trait_key = 65
str_traits = "poisoned"

[sub_resource type="Resource" id="Resource_poisoned_result"]
script = ExtResource("4_result")
