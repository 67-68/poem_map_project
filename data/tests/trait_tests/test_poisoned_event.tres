[sub_resource type="Resource" id="Resource_poisoned_option"]
script = ExtResource("5_evopt")
choice_result = SubResource("Resource_poisoned_result")
description = "喝下这碗汤药"

[resource]
script = ExtResource("6_event")
era = "1_core_rules"
options = Array[ExtResource("1_opt")]([SubResource("Resource_poisoned_option")])
uuid = "test_poisoned_event"
name = "【测试】中毒"
description = "药罐里冒着白气，苦涩的药味钻入鼻腔。郎中说这方子能驱寒，但服下之后腹中翻涌不止——你的手指开始发青。"
