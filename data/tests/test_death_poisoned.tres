[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/random_event.gd" id="event"]
[ext_resource type="Script" path="res://model/event/base_option.gd" id="opt"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="evopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="baseop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="prop"]
[ext_resource type="Script" path="res://core/model/trait_operator.gd" id="traitop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="cr"]

[sub_resource type="Resource" id="trait_poisoned"]
script = ExtResource("traitop")
str_traits = "poisoned"

[sub_resource type="Resource" id="prop_health"]
script = ExtResource("prop")
str_props = "health"
value = -50

[sub_resource type="Resource" id="result"]
script = ExtResource("cr")
operators = Array[ExtResource("baseop")]([SubResource("trait_poisoned"), SubResource("prop_health")])

[sub_resource type="Resource" id="option"]
script = ExtResource("evopt")
choice_result = SubResource("result")
description = "中毒+扣50血"

[resource]
script = ExtResource("event")
era = "1_core_rules"
options = Array[ExtResource("opt")]([SubResource("option")])
uuid = "test_death_poisoned"
name = "【测试】毒发身亡"
description = "赋予中毒trait，扣50血。死亡后触发毒发。"
