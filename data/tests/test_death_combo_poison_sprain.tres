[gd_resource type="Resource" script_class="RandomEvent" format=3 uid="uid://duxbsjl5keksp"]

[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="baseop"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="cr"]
[ext_resource type="Script" uid="uid://qhuu117ngmbk" path="res://model/random_event.gd" id="event"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="evopt"]
[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="opt"]
[ext_resource type="Script" uid="uid://d25kbxawh53k4" path="res://core/model/property_operator.gd" id="prop"]
[ext_resource type="Script" uid="uid://dp5gqdkppjq17" path="res://core/model/trait_operator.gd" id="traitop"]

[sub_resource type="Resource" id="trait_poisoned"]
script = ExtResource("traitop")
_trait_key = 65
str_traits = "poisoned"

[sub_resource type="Resource" id="trait_sprained"]
script = ExtResource("traitop")
_trait_key = 66
str_traits = "sprained_ankle"

[sub_resource type="Resource" id="prop_health"]
script = ExtResource("prop")
str_props = "health"
value = -50

[sub_resource type="Resource" id="result"]
script = ExtResource("cr")
operators = Array[ExtResource("baseop")]([SubResource("trait_poisoned"), SubResource("trait_sprained"), SubResource("prop_health")])

[sub_resource type="Resource" id="option"]
script = ExtResource("evopt")
choice_result = SubResource("result")
description = "中毒+崴脚+扣50血"

[resource]
script = ExtResource("event")
era = "1_core_rules"
options = Array[ExtResource("opt")]([SubResource("option")])
uuid = "test_death_combo_poison_sprain"
name = "【测试】毒+崴脚濒死"
description = "同时赋予中毒和崴脚trait，扣50血。死亡后可匹配多个tag。"
