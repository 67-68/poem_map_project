[resource]
script = ExtResource("6_event")
era = "1_core_rules"
options = Array[ExtResource("1_opt")]([SubResource("Resource_sprained_option")])
uuid = "test_sprained_ankle_event"
name = "【测试】崴脚"
description = "石板缝里冒出半截老树根，等你发现时已经晚了——脚踝猛地一扭，咔嚓一声，整个人扑倒在泥地上。你撑着地爬起来，脚踝火辣辣地疼，一步都难挪。"
