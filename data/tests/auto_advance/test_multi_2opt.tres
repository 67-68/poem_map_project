[resource]
script = ExtResource("4_re")
options = Array[ExtResource("1_opt")]([SubResource("Resource_option_a"), SubResource("Resource_option_b")])
uuid = "test_multi_2opt"
name = "【测试】双选项·超时无视"
description = "正当你胡思乱想之际，值房的门又开了半扇。老吏探出头来，端着半碗热羹：「后生，这天怪冷的。你是再叩一次门，还是去街对面的茶铺先暖暖？」热羹的白气在他面前袅袅散开，你忽然觉得肚子有些饿了。"
lasting_time = 3.0
