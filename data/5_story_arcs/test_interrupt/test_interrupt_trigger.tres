[gd_resource type="Resource" script_class="RandomEvent" format=3 uid="uid://test_interrupt_trigger"]

[ext_resource type="Script" uid="uid://cb4e8rnm0l8jx" path="res://core/model/base_operator.gd" id="1_baseop"]
[ext_resource type="Script" uid="uid://prpfdj2ag46k" path="res://model/choice_result.gd" id="3_cr"]
[ext_resource type="Script" uid="uid://ceaxs0erf12ea" path="res://model/event/event_option.gd" id="4_eo"]
[ext_resource type="Script" uid="uid://h47l1kimdegr" path="res://model/event/base_option.gd" id="5_bo"]
[ext_resource type="Script" uid="uid://qhuu117ngmbk" path="res://model/random_event.gd" id="6_re"]
[ext_resource type="Script" uid="uid://cxfcnsval1p54" path="res://core/operators/push_event_operator.gd" id="7_pe"]

[sub_resource type="Resource" id="Resource_push_display"]
script = ExtResource("7_pe")
event_key = "test_interrupt_display"
inject_interrupt_text = "去看看发生了什么"
inject_interrupt_event_key = "test_interrupt_target"
metadata/_custom_type_script = "uid://cxfcnsval1p54"

[sub_resource type="Resource" id="Resource_cr_trigger"]
script = ExtResource("3_cr")
operators = Array[ExtResource("1_baseop")]([SubResource("Resource_push_display")])

[sub_resource type="Resource" id="Resource_opt_trigger"]
script = ExtResource("4_eo")
choice_result = SubResource("Resource_cr_trigger")
description = "派仆从去打探消息"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("6_re")
options = Array[ExtResource("5_bo")]([SubResource("Resource_opt_trigger")])
uuid = "test_interrupt_trigger"
name = "府中闲坐"
description = "你在府中闲坐看书，忽然听到街市方向传来一阵嘈杂的喧哗声。仆役匆匆来报，说街市上出了事，似乎有人与武侯发生了冲突。你放下书卷，犹豫是否要遣人前去打探。"
metadata/_custom_type_script = "uid://qhuu117ngmbk"
