[sub_resource type="Resource" id="Resource_bx36x"]
script = ExtResource("3_dqdj3")
choice_result = SubResource("Resource_a6jx1")
description = "天大笑，将残酒猛地泼在那团烂泥般的诗稿上。去他娘的野无遗贤！"
metadata/_custom_type_script = "uid://ceaxs0erf12ea"

[resource]
script = ExtResource("2_wlnfx")
options = Array[ExtResource("1_xq5hs")]([SubResource("Resource_doaqb"), SubResource("Resource_bx36x")])
uuid = "changan_walk_08_the_crossroads"
description = "你独自站在冷风中。左手是那团糊满烂泥的干谒诗稿，右手是空荡荡的酒碗。过去的三年，你就像一台精确的机器，每天在那些朱门前计算着笑容的弧度和弯腰的角度。现在，你看着地上相国府马车留下的深深车辙，那股支撑着你的发条……好像断了。"
metadata/_custom_type_script = "uid://cpb80yg1s313y"
