[sub_resource type="Resource" id="Resource_doaqb"]
script = ExtResource("2_jhtqw")
is_disabled = true
disabled_reason = "一阵寒风吹过，你猛地干呕起来。你的胃和你的脊梁比理智更早做出了决定——你已经无法强迫自己的双膝再弯下去了。(未解锁，正式版解锁）"
description = "[未解锁] 捡起烂泥里的残稿。也许明天去右相府门前长跪不起，哪怕只求个幕僚的位子……"
metadata/_custom_type_script = "uid://dipsh2f0qa3ei"

