uuid = "fengxian_village_entrance_revisit"
name = "奉先村村头"
description = "你又站在了村口。风还是从骊山方向来，但现在你知道有些东西已经不一样了。里正死了，那片你住过的区域已经换了模样——他们似乎搬迁到了你不熟悉的地方。你不常回来，也没钱，这些年村子对你来说，已经成了一个陌生的地方。"
icon = ExtResource("1_gjrey")
ui_decl = SubResource("Resource_rq3a5")
