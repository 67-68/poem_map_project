[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/event/base_option.gd" id="1_baseopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="3_prop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="4_cr"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="5_evopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="6_re"]

;; ── Option A: money -40 — 清流消耗减免（才华 dampen）──
[sub_resource type="Resource" id="Res_prop_money_qing"]
script = ExtResource("3_prop")
_property = 0
value = -40

[sub_resource type="Resource" id="Res_cr_money_qing"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_money_qing")])

[sub_resource type="Resource" id="Res_opt_money_qing"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_money_qing")
description = "A) 清流索钱 -40 (才华↓清流消耗)"

;; ── Option B: health -20 — 清流消耗减免 ──
[sub_resource type="Resource" id="Res_prop_health_qing"]
script = ExtResource("3_prop")
_property = 1
value = -20

[sub_resource type="Resource" id="Res_cr_health_qing"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_health_qing")])

[sub_resource type="Resource" id="Res_opt_health_qing"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_health_qing")
description = "B) 清流伤身 -20 (才华↓清流消耗)"

;; ── Option C: time -5 — 清流时间消耗减免 ──
[sub_resource type="Resource" id="Res_prop_time_qing"]
script = ExtResource("3_prop")
_property = 5
value = -5

[sub_resource type="Resource" id="Res_cr_time_qing"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_time_qing")])

[sub_resource type="Resource" id="Res_opt_time_qing"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_time_qing")
description = "C) 清流耗时 -5 (才华↓清流消耗)"

[resource]
script = ExtResource("6_re")
era = ""
archetype_id = ""
_target_tags = Array[String]([])
options = Array[ExtResource("1_baseopt")]([SubResource("Res_opt_money_qing"), SubResource("Res_opt_health_qing"), SubResource("Res_opt_time_qing")])
uuid = "test_modifier_qingliu_faction"
name = "【测试】修饰符-清流交互"
description = "需要先通过 debug console 注入清流 NPC 上下文。\n注入指令: PlayerState.last_event[\"target_tag\"] = \"gaoshi\"\n\n预期（才华 50）：A) 钱-40 → 清流 dampen → ~-24\nB) 健-20 → 清流 dampen → ~-12\nC) 时-5 → 清流 dampen → ~-3"
