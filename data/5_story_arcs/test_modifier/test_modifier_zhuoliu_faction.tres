[gd_resource type="Resource" script_class="RandomEvent" format=3]

[ext_resource type="Script" path="res://model/event/base_option.gd" id="1_baseopt"]
[ext_resource type="Script" path="res://core/model/base_operator.gd" id="2_baseop"]
[ext_resource type="Script" path="res://core/model/property_operator.gd" id="3_prop"]
[ext_resource type="Script" path="res://model/choice_result.gd" id="4_cr"]
[ext_resource type="Script" path="res://model/event/event_option.gd" id="5_evopt"]
[ext_resource type="Script" path="res://model/random_event.gd" id="6_re"]

;; ── Option A: money -40 — 浊流消耗减免（城府 dampen）──
[sub_resource type="Resource" id="Res_prop_money_zhuo"]
script = ExtResource("3_prop")
_property = 0
value = -40

[sub_resource type="Resource" id="Res_cr_money_zhuo"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_money_zhuo")])

[sub_resource type="Resource" id="Res_opt_money_zhuo"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_money_zhuo")
description = "TRES_TEST_MODIFIER_ZHUOLIU_FACTION_DESCRIPTION_0"

;; ── Option B: health -20 — 浊流消耗减免 ──
[sub_resource type="Resource" id="Res_prop_health_zhuo"]
script = ExtResource("3_prop")
_property = 1
value = -20

[sub_resource type="Resource" id="Res_cr_health_zhuo"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_health_zhuo")])

[sub_resource type="Resource" id="Res_opt_health_zhuo"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_health_zhuo")
description = "TRES_TEST_MODIFIER_ZHUOLIU_FACTION_DESCRIPTION_1"

;; ── Option C: prestige +20 — 对比：望获取不走 faction ──
[sub_resource type="Resource" id="Res_prop_prestige_zhuo"]
script = ExtResource("3_prop")
_property = 2
value = 20

[sub_resource type="Resource" id="Res_cr_prestige_zhuo"]
script = ExtResource("4_cr")
operators = Array[ExtResource("2_baseop")]([SubResource("Res_prop_prestige_zhuo")])

[sub_resource type="Resource" id="Res_opt_prestige_zhuo"]
script = ExtResource("5_evopt")
choice_result = SubResource("Res_cr_prestige_zhuo")
description = "TRES_TEST_MODIFIER_ZHUOLIU_FACTION_DESCRIPTION_2"

[resource]
script = ExtResource("6_re")
era = ""
archetype_id = ""
_target_tags = Array[String]([])
options = Array[ExtResource("1_baseopt")]([SubResource("Res_opt_money_zhuo"), SubResource("Res_opt_health_zhuo"), SubResource("Res_opt_prestige_zhuo")])
uuid = "test_modifier_zhuoliu_faction"
name = "TRES_TEST_MODIFIER_ZHUOLIU_FACTION_NAME_0"
description = "TRES_TEST_MODIFIER_ZHUOLIU_FACTION_DESCRIPTION_3"
